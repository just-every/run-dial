{
  "schema": 1,
  "projectId": "just-every/dial",
  "name": "Dial",
  "sourceRepository": "https://github.com/just-every/run-dial",
  "license": "MIT",
  "deployment": {
    "target": "cloudflare-workers",
    "artifactFile": "rer-worker-artifact.json"
  },
  "operations": {
    "setup": "pnpm install --frozen-lockfile",
    "build": "pnpm run build",
    "verify": "pnpm run validate && pnpm run boundaries",
    "artifact": "node scripts/build-delivery-artifact.mjs",
    "recovery": "Preserve the private deployment receipt, owner-held SESSION_SECRET, and applied migration history. Restore only into an empty migrated installation with writers stopped; reconnect calendars and recheck mail before publishing booking events."
  },
  "verification": {
    "sensitivePaths": [
      "src/core/features/operators/**",
      "src/core/features/editor/**",
      "src/core/app/worker.ts",
      "src/core/app/hono.ts",
      "src/core/shared/runtime-env*",
      "modules/operator-auth/**",
      "modules/owner-claim/**",
      "modules/editor/**",
      "scripts/archive/**",
      "scripts/delivery/**",
      "scripts/projects/**",
      "scripts/build-delivery-artifact.mjs",
      "rer-setup.json",
      ".github/workflows/rer-managed.yml"
    ],
    "migrationDirectories": [
      "migrations/core"
    ],
    "guidanceFiles": [
      "AGENTS.md",
      "CONTRACT.md",
      "OPERATIONS.md"
    ],
    "testPatterns": [
      "tests/*.test.mjs"
    ]
  },
  "setup": {
    "path": "rer-setup.json",
    "sha256": "686e84b61869c93083d7424ce562a45ad91f57055695ee17ea26dc8dbf8ab243"
  }
}
