er_delivery.sql","0005_booking_lifecycle.sql","0006_requests_embeds.sql","0007_calendar_reconciliation.sql","0008_delivery_recovery_erasure.sql","0009_calendar_deletion_probes.sql","0010_public_admission.sql","0011_operator_creation_receipts.sql","0012_operator_creation_tombstones.sql","0013_operator_access.sql","0014_operator_mail_invocations.sql","0015_operator_notification_generation.sql","0016_base_operator_auth.sql","0017_base_mail_dispatch.sql","0018_sendgrid_provider_identity.sql","0019_request_only_events.sql","0020_base_development_outbox.sql","0021_remove_development_magic_link_sink.sql","0022_development_mail_health.sql","0023_base_invitation_cancellation.sql","0024_archive_historical_effects.sql","0025_host_link_copy_reports.sql","0026_portability.sql","0027_first_run_setup.sql","0028_owner_claim.sql","0029_move_in_import.sql","0030_dev_sessions.sql","0031_auth_domain_rules_step_up.sql","0032_host_avatar.sql","0033_booking_search.sql","0034_extension_custom_fields.sql","0035_person_erasure.sql","0036_person_record_erasure.sql","0037_erasure_scope.sql","0038_erasure_rates.sql","0039_retire_uncorrelated_rate_rows.sql","0040_move_in_cutover.sql","0041_import_custody_retirement.sql","0042_optional_calendar.sql","0043_hosted_portability.sql","0044_local_dependency_setup.sql","0045_import_preparation_steps.sql","0046_import_stream_sources.sql","0047_auth_provider_controls.sql","0048_auth_dependency_setup.sql","0049_auth_owner_signin.sql","0050_managed_mail_health.sql","0051_phone_dropdown_questions.sql","0052_booking_horizons.sql","0053_event_duration_options.sql","0054_booking_link_context.sql","0055_availability_controls.sql","0056_booking_policy.sql","0057_correspondence.sql","0058_reschedule_requests.sql","0060_event_location_options.sql","0061_booking_links.sql"],"objects":[{"bucket":"FILES","customMetadata":{},"httpMetadata":{"contentType":"text/plain"},"key":"attachments/appointment-notes.txt","sha256":"fa48d296f8fe3d7dc798663cd7ddd416f8047eeca712fe25ee1a6b840f16752f","size":40},{"bucket":"FILES","customMetadata":{},"httpMetadata":{"contentType":"image/jpeg"},"key":"avatars/qualification-host.jpg","sha256":"56f1ea5885324dd2629c67db3399eddc9813346cc9ebd6ec25083d0dfc155654","size":632}],"partCount":69,"payloads":[{"name":"owner-salt-continuity","sha256":"1d7ed0056cde06e1732c6bbfe9c8ffba977400e1419566097f415cf50293eac6","size":64},{"name":"schema-proof","sha256":"e520555c7cd2f215fb467ba84282d8e0ec8b513059d312eeddb0771a6310bbfa","size":185313}],"product":"just-every/dial","requiredConfiguration":["OWNER_EMAIL","SESSION_SECRET","SETUP_TOKEN","APP_URL","MAIL_PROVIDER","MAIL_FROM","GOOGLE_OAUTH_CLIENT_ID","GOOGLE_OAUTH_CLIENT_SECRET","CALENDAR_WEBHOOK_SECRET"],"schema":"eb78a7192b63c8940e729630a227f31e07b5eed6ba689d53e342214f7d9546b9","schemaObjects":[{"name":"availability_date_overrides_event_date_idx","sql":"CREATE INDEX availability_date_overrides_event_date_idx\n  ON availability_date_overrides(event_type_id, host_date)","table":"availability_date_overrides","type":"index"},{"name":"availability_request_review_nonces_expiry_idx","sql":"CREATE INDEX availability_request_review_nonces_expiry_idx\n  ON availability_request_review_nonces(expires_at, consumed_at)","table":"availability_request_review_nonces","type":"index"},{"name":"availability_request_windows_request_idx","sql":"CREATE INDEX availability_request_windows_request_idx\n  ON availability_request_windows(request_id, requested_date, start_minute)","table":"availability_request_windows","type":"index"},{"name":"availability_requests_event_type_idx","sql":"CREATE INDEX availability_requests_event_type_idx\n  ON availability_requests(event_type_id, submitted_at)","table":"availability_requests","type":"index"},{"name":"availability_requests_state_submitted_idx","sql":"CREATE INDEX availability_requests_state_submitted_idx\n  ON availability_requests(state, submitted_at)","table":"availability_requests","type":"index"},{"name":"booking_calendar_conflicts_open_idx","sql":"CREATE INDEX booking_calendar_conflicts_open_idx\n  ON booking_calendar_conflicts(booking_id, state, created_at)","table":"booking_calendar_conflicts","type":"index"},{"name":"booking_history_booking_idx","sql":"CREATE INDEX booking_history_booking_idx ON booking_history(booking_id, created_at)","table":"booking_history","type":"index"},{"name":"booking_links_booking_idx","sql":"CREATE UNIQUE INDEX booking_links_booking_idx ON booking_links(consumed_booking_id) WHERE consumed_booking_id IS NOT NULL","table":"booking_links","type":"index"},{"name":"booking_links_event_idx","sql":"CREATE INDEX booking_links_event_idx ON booking_links(event_type_id,created_at)","table":"booking_links","type":"index"},{"name":"booking_manage_tokens_lookup_idx","sql":"CREATE INDEX booking_manage_tokens_lookup_idx\n  ON booking_manage_tokens(token_hash, expires_at, rotated_at, invalidated_at)","table":"booking_manage_tokens","type":"index"},{"name":"booking_nonces_lookup_idx","sql":"CREATE INDEX booking_nonces_lookup_idx ON booking_nonces(nonce_hash, expires_at, consumed_at)","table":"booking_nonces","type":"index"},{"name":"booking_occurrences_conflict_idx","sql":"CREATE INDEX booking_occurrences_conflict_idx\n  ON booking_occurrences(occupied_start_at, occupied_end_at, is_current)","table":"booking_occurrences","type":"index"},{"name":"booking_occurrences_host_date_idx","sql":"CREATE INDEX booking_occurrences_host_date_idx\n  ON booking_occurrences(host_date, is_current)","table":"booking_occurrences","type":"index"},{"name":"booking_occurrences_limits_start","sql":"CREATE INDEX booking_occurrences_limits_start ON booking_occurrences(start_at) WHERE is_current=1","table":"booking_occurrences","type":"index"},{"name":"booking_occurrences_one_current_idx","sql":"CREATE UNIQUE INDEX booking_occurrences_one_current_idx\n  ON booking_occurrences(booking_id) WHERE is_current = 1","table":"booking_occurrences","type":"index"},{"name":"booking_reschedule_request_due","sql":"CREATE INDEX booking_reschedule_request_due ON booking_reschedule_requests(state,expires_at,reminder_at)","table":"booking_reschedule_requests","type":"index"},{"name":"booking_reschedule_request_open","sql":"CREATE UNIQUE INDEX booking_reschedule_request_open ON booking_reschedule_requests(booking_id) WHERE state='open' AND archive_historical=0","table":"booking_reschedule_requests","type":"index"},{"name":"booking_search_folded_idx","sql":"CREATE INDEX booking_search_folded_idx ON bookings(invitee_name_folded, invitee_email_folded, id)","table":"bookings","type":"index"},{"name":"booking_search_insert","sql":"CREATE TRIGGER booking_search_insert AFTER INSERT ON bookings BEGIN\n  UPDATE bookings SET invitee_name_folded = (WITH RECURSIVE fold(remaining, result) AS (\n  SELECT NEW.invitee_name, ''\n  UNION ALL SELECT CAST(substr(CAST(remaining AS BLOB),\n    max(1, length(CAST(substr(remaining, 1, 1) AS BLOB))) + 1) AS TEXT), result || coalesce(\n    (SELECT folded FROM booking_search_casefold WHERE codepoint = unicode(remaining)),\n    CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining, 1, 1) END)\n  FROM fold WHERE length(CAST(remaining AS BLOB)) > 0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB)) = 0),\n  invitee_email_folded = (WITH RECURSIVE fold(remaining, result) AS (\n  SELECT NEW.invitee_email, ''\n  UNION ALL SELECT CAST(substr(CAST(remaining AS BLOB),\n    max(1, length(CAST(substr(remaining, 1, 1) AS BLOB))) + 1) AS TEXT), result || coalesce(\n    (SELECT folded FROM booking_search_casefold WHERE codepoint = unicode(remaining)),\n    CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining, 1, 1) END)\n  FROM fold WHERE length(CAST(remaining AS BLOB)) > 0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB)) = 0) WHERE id = NEW.id;\nEND","table":"bookings","type":"trigger"},{"name":"booking_search_invitee_update","sql":"CREATE TRIGGER booking_search_invitee_update AFTER UPDATE OF invitee_name, invitee_email ON bookings BEGIN\n  UPDATE bookings SET invitee_name_folded = (WITH RECURSIVE fold(remaining, result) AS (\n  SELECT NEW.invitee_name, ''\n  UNION ALL SELECT CAST(substr(CAST(remaining AS BLOB),\n    max(1, length(CAST(substr(remaining, 1, 1) AS BLOB))) + 1) AS TEXT), result || coalesce(\n    (SELECT folded FROM booking_search_casefold WHERE codepoint = unicode(remaining)),\n    CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining, 1, 1) END)\n  FROM fold WHERE length(CAST(remaining AS BLOB)) > 0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB)) = 0),\n  invitee_email_folded = (WITH RECURSIVE fold(remaining, result) AS (\n  SELECT NEW.invitee_email, ''\n  UNION ALL SELECT CAST(substr(CAST(remaining AS BLOB),\n    max(1, length(CAST(substr(remaining, 1, 1) AS BLOB))) + 1) AS TEXT), result || coalesce(\n    (SELECT folded FROM booking_search_casefold WHERE codepoint = unicode(remaining)),\n    CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining, 1, 1) END)\n  FROM fold WHERE length(CAST(remaining AS BLOB)) > 0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB)) = 0) WHERE id = NEW.id;\nEND","table":"bookings","type":"trigger"},{"name":"bookings_calendar_provider_event_idx","sql":"CREATE UNIQUE INDEX bookings_calendar_provider_event_idx\n  ON bookings(calendar_provider_event_id)\n  WHERE calendar_provider_event_id IS NOT NULL","table":"bookings","type":"index"},{"name":"bookings_event_type_idx","sql":"CREATE INDEX bookings_event_type_idx ON bookings(event_type_id, state)","table":"bookings","type":"index"},{"name":"bookings_invitee_lookup_idx","sql":"CREATE INDEX bookings_invitee_lookup_idx ON bookings(invitee_email, invitee_name)","table":"bookings","type":"index"},{"name":"bookings_lifecycle_idx","sql":"CREATE INDEX bookings_lifecycle_idx ON bookings(state, created_at)","table":"bookings","type":"index"},{"name":"bookings_limits_invitee","sql":"CREATE INDEX bookings_limits_invitee ON bookings(lower(trim(invitee_email)),state)","table":"bookings","type":"index"},{"name":"calendar_busy_intervals_lookup_idx","sql":"CREATE INDEX calendar_busy_intervals_lookup_idx\n  ON calendar_busy_intervals(calendar_id, starts_at, ends_at, observed_at)","table":"calendar_busy_intervals","type":"index"},{"name":"calendar_busy_read_windows_coverage_idx","sql":"CREATE INDEX calendar_busy_read_windows_coverage_idx\n  ON calendar_busy_read_windows(calendar_id, starts_at, ends_at, observed_at)","table":"calendar_busy_read_windows","type":"index"},{"name":"calendar_connection_single_destination_idx","sql":"CREATE UNIQUE INDEX calendar_connection_single_destination_idx\n  ON calendar_connection_calendars(purpose) WHERE purpose = 'destination'","table":"calendar_connection_calendars","type":"index"},{"name":"calendar_deletion_probes_due","sql":"CREATE INDEX calendar_deletion_probes_due ON calendar_deletion_probes(state, next_attempt_at)","table":"calendar_deletion_probes","type":"index"},{"name":"calendar_oauth_states_expiry_idx","sql":"CREATE INDEX calendar_oauth_states_expiry_idx\n  ON calendar_oauth_states(expires_at, consumed_at)","table":"calendar_oauth_states","type":"index"},{"name":"calendar_push_channels_expiry_idx","sql":"CREATE INDEX calendar_push_channels_expiry_idx\n  ON calendar_push_channels(expires_at)","table":"calendar_push_channels","type":"index"},{"name":"close_reschedule_request_on_cancel","sql":"CREATE TRIGGER close_reschedule_request_on_cancel AFTER UPDATE OF state ON bookings\nWHEN NEW.state='cancelled' BEGIN\n UPDATE booking_reschedule_requests SET state='cancelled',updated_at=NEW.updated_at WHERE booking_id=NEW.id AND state='open' AND archive_historical=0;\nEND","table":"bookings","type":"trigger"},{"name":"close_reschedule_request_on_pick","sql":"CREATE TRIGGER close_reschedule_request_on_pick AFTER UPDATE OF current_occurrence_id ON bookings\nWHEN NEW.current_occurrence_id<>OLD.current_occurrence_id BEGIN\n INSERT INTO booking_request_history(id,booking_id,occurrence_id,action,actor_type,created_at)\n SELECT NEW.current_occurrence_id,NEW.id,NEW.current_occurrence_id,'reschedule_request_picked','system',NEW.updated_at\n FROM booking_reschedule_requests WHERE booking_id=NEW.id AND state='open' AND archive_historical=0;\n UPDATE booking_reschedule_requests SET state='picked',updated_at=NEW.updated_at WHERE booking_id=NEW.id AND state='open' AND archive_historical=0;\nEND","table":"bookings","type":"trigger"},{"name":"delivery_outbox_booking_idx","sql":"CREATE INDEX delivery_outbox_booking_idx\n  ON delivery_outbox(booking_id, occurrence_id, state)","table":"delivery_outbox","type":"index"},{"name":"delivery_outbox_due_idx","sql":"CREATE INDEX delivery_outbox_due_idx\n  ON delivery_outbox(state, next_attempt_at, created_at)","table":"delivery_outbox","type":"index"},{"name":"delivery_outbox_request_idx","sql":"CREATE INDEX delivery_outbox_request_idx\n  ON delivery_outbox(request_id, state)","table":"delivery_outbox","type":"index"},{"name":"dial_base_operator_insert","sql":"CREATE TRIGGER dial_base_operator_insert AFTER INSERT ON oa_operators BEGIN\n INSERT INTO operators(id,email,normalized_email,created_at,updated_at,removed_at)\n VALUES(NEW.id,NEW.email,NEW.email,strftime('%Y-%m-%dT%H:%M:%fZ',NEW.created_at/1000.0,'unixepoch'),\n strftime('%Y-%m-%dT%H:%M:%fZ','now'),CASE WHEN NEW.status='active' THEN NULL ELSE strftime('%Y-%m-%dT%H:%M:%fZ','now') END);\n INSERT INTO operator_setup_identity(singleton_key,operator_id,created_at)\n SELECT 'default',NEW.id,strftime('%Y-%m-%dT%H:%M:%fZ','now')\n WHERE EXISTS(SELECT 1 FROM oa_bootstrap WHERE claim_id=NEW.id) ON CONFLICT DO NOTHING;\nEND","table":"oa_operators","type":"trigger"},{"name":"dial_base_operator_status","sql":"CREATE TRIGGER dial_base_operator_status AFTER UPDATE OF status ON oa_operators\n WHEN OLD.status != NEW.status BEGIN\n UPDATE operators SET removed_at=CASE WHEN NEW.status='active' THEN NULL ELSE strftime('%Y-%m-%dT%H:%M:%fZ','now') END,\n updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE id=NEW.id;\nEND","table":"oa_operators","type":"trigger"},{"name":"dial_equal_operator_role_insert","sql":"CREATE TRIGGER dial_equal_operator_role_insert BEFORE INSERT ON oa_operators\n WHEN NEW.role != 'owner' BEGIN SELECT RAISE(ABORT,'dial_equal_operators'); END","table":"oa_operators","type":"trigger"},{"name":"dial_equal_operator_role_update","sql":"CREATE TRIGGER dial_equal_operator_role_update BEFORE UPDATE OF role ON oa_operators\n WHEN NEW.role != 'owner' BEGIN SELECT RAISE(ABORT,'dial_equal_operators'); END","table":"oa_operators","type":"trigger"},{"name":"dial_portability_one_export","sql":"CREATE UNIQUE INDEX dial_portability_one_export ON dial_portability_admission(kind) WHERE kind='export'","table":"dial_portability_admission","type":"index"},{"name":"erasure_anonymous_operator_immutable","sql":"CREATE TRIGGER erasure_anonymous_operator_immutable BEFORE UPDATE ON oa_operators\nWHEN EXISTS(SELECT 1 FROM operators WHERE id=OLD.id AND erased_at IS NOT NULL)\n AND (NEW.status!='inactive' OR NEW.email!='erased:'||OLD.id OR NEW.display_name!='Removed operator')\nBEGIN SELECT RAISE(ABORT,'operator_identity_erased'); END","table":"oa_operators","type":"trigger"},{"name":"erasure_booking_admission","sql":"CREATE TRIGGER erasure_booking_admission BEFORE INSERT ON bookings\nWHEN EXISTS(SELECT 1 FROM person_erasure_locks WHERE email=(WITH RECURSIVE fold(remaining,result) AS (\n SELECT trim(NEW.invitee_email), '' UNION ALL\n SELECT CAST(substr(CAST(remaining AS BLOB),max(1,length(CAST(substr(remaining,1,1) AS BLOB)))+1) AS TEXT),\n result || coalesce((SELECT folded FROM booking_search_casefold WHERE codepoint=unicode(remaining)),CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining,1,1) END)\n FROM fold WHERE length(CAST(remaining AS BLOB))>0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB))=0))\nBEGIN SELECT RAISE(ABORT,'person_erasure_in_progress'); END","table":"bookings","type":"trigger"},{"name":"erasure_booking_identity_update","sql":"CREATE TRIGGER erasure_booking_identity_update BEFORE UPDATE OF invitee_email ON bookings\nWHEN OLD.invitee_email IS NOT NEW.invitee_email AND EXISTS(SELECT 1 FROM person_erasure_locks WHERE email IN ((WITH RECURSIVE fold(remaining,result) AS (\n SELECT trim(OLD.invitee_email), '' UNION ALL\n SELECT CAST(substr(CAST(remaining AS BLOB),max(1,length(CAST(substr(remaining,1,1) AS BLOB)))+1) AS TEXT),\n result || coalesce((SELECT folded FROM booking_search_casefold WHERE codepoint=unicode(remaining)),CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining,1,1) END)\n FROM fold WHERE length(CAST(remaining AS BLOB))>0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB))=0),(WITH RECURSIVE fold(remaining,result) AS (\n SELECT trim(NEW.invitee_email), '' UNION ALL\n SELECT CAST(substr(CAST(remaining AS BLOB),max(1,length(CAST(substr(remaining,1,1) AS BLOB)))+1) AS TEXT),\n result || coalesce((SELECT folded FROM booking_search_casefold WHERE codepoint=unicode(remaining)),CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining,1,1) END)\n FROM fold WHERE length(CAST(remaining AS BLOB))>0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB))=0)))\nBEGIN SELECT RAISE(ABORT,'person_erasure_in_progress'); END","table":"bookings","type":"trigger"},{"name":"erasure_delivery_admission","sql":"CREATE TRIGGER erasure_delivery_admission BEFORE INSERT ON delivery_outbox\nWHEN NEW.kind IN ('mail_send','reminder') AND (\n EXISTS(SELECT 1 FROM person_erasure_locks WHERE email=(WITH RECURSIVE fold(remaining,result) AS (\n SELECT trim(json_extract(NEW.payload_json,'$.to')), '' UNION ALL\n SELECT CAST(substr(CAST(remaining AS BLOB),max(1,length(CAST(substr(remaining,1,1) AS BLOB)))+1) AS TEXT),\n result || coalesce((SELECT folded FROM booking_search_casefold WHERE codepoint=unicode(remaining)),CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining,1,1) END)\n FROM fold WHERE length(CAST(remaining AS BLOB))>0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB))=0))\n OR EXISTS(SELECT 1 FROM bookings b JOIN person_erasure_locks l ON l.email=b.invitee_email_folded WHERE b.id=NEW.booking_id)\n OR EXISTS(SELECT 1 FROM availability_requests q JOIN person_erasure_locks l ON l.email=(WITH RECURSIVE fold(remaining,result) AS (\n SELECT trim(q.invitee_email), '' UNION ALL\n SELECT CAST(substr(CAST(remaining AS BLOB),max(1,length(CAST(substr(remaining,1,1) AS BLOB)))+1) AS TEXT),\n result || coalesce((SELECT folded FROM booking_search_casefold WHERE codepoint=unicode(remaining)),CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining,1,1) END)\n FROM fold WHERE length(CAST(remaining AS BLOB))>0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB))=0) WHERE q.id=NEW.request_id)\n OR (NEW.booking_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM bookings WHERE id=NEW.booking_id))\n OR (NEW.request_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM availability_requests WHERE id=NEW.request_id))\n)\nBEGIN SELECT RAISE(ABORT,'person_erasure_in_progress'); END","table":"delivery_outbox","type":"trigger"},{"name":"erasure_development_mail_source","sql":"CREATE TRIGGER erasure_development_mail_source BEFORE INSERT ON rer_mail_development_outbox\nWHEN NOT EXISTS(SELECT 1 FROM delivery_outbox WHERE idempotency_key=json_extract(NEW.message,'$.deliveryId') OR json_extract(payload_json,'$.providerIdempotencyKey')=json_extract(NEW.message,'$.deliveryId'))\n AND NOT EXISTS(SELECT 1 FROM oa_tokens WHERE id=json_extract(NEW.message,'$.deliveryId'))\n AND NOT EXISTS(SELECT 1 FROM oa_step_up_challenges WHERE id=json_extract(NEW.message,'$.deliveryId'))\nBEGIN SELECT RAISE(ABORT,'mail_source_erased'); END","table":"rer_mail_development_outbox","type":"trigger"},{"name":"erasure_dispatch_source","sql":"CREATE TRIGGER erasure_dispatch_source BEFORE INSERT ON base_mail_dispatch\nWHEN NOT EXISTS(SELECT 1 FROM delivery_outbox WHERE idempotency_key=NEW.delivery_id OR json_extract(payload_json,'$.providerIdempotencyKey')=NEW.delivery_id)\n AND NOT EXISTS(SELECT 1 FROM oa_tokens WHERE id=NEW.delivery_id)\n AND NOT EXISTS(SELECT 1 FROM oa_step_up_challenges WHERE id=NEW.delivery_id)\nBEGIN SELECT RAISE(ABORT,'mail_source_erased'); END","table":"base_mail_dispatch","type":"trigger"},{"name":"erasure_native_identity_admission","sql":"CREATE TRIGGER erasure_native_identity_admission BEFORE INSERT ON oa_operators\nWHEN EXISTS(SELECT 1 FROM person_erasure_locks WHERE email=(WITH RECURSIVE fold(remaining,result) AS (\n SELECT trim(NEW.email), '' UNION ALL\n SELECT CAST(substr(CAST(remaining AS BLOB),max(1,length(CAST(substr(remaining,1,1) AS BLOB)))+1) AS TEXT),\n result || coalesce((SELECT folded FROM booking_search_casefold WHERE codepoint=unicode(remaining)),CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining,1,1) END)\n FROM fold WHERE length(CAST(remaining AS BLOB))>0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB))=0))\nBEGIN SELECT RAISE(ABORT,'person_erasure_in_progress'); END","table":"oa_operators","type":"trigger"},{"name":"erasure_native_identity_change","sql":"CREATE TRIGGER erasure_native_identity_change BEFORE UPDATE OF email ON oa_operators\nWHEN OLD.email IS NOT NEW.email AND (\n EXISTS(SELECT 1 FROM person_erasure_locks WHERE email=(WITH RECURSIVE fold(remaining,result) AS (\n SELECT trim(NEW.email), '' UNION ALL\n SELECT CAST(substr(CAST(remaining AS BLOB),max(1,length(CAST(substr(remaining,1,1) AS BLOB)))+1) AS TEXT),\n result || coalesce((SELECT folded FROM booking_search_casefold WHERE codepoint=unicode(remaining)),CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining,1,1) END)\n FROM fold WHERE length(CAST(remaining AS BLOB))>0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB))=0))\n OR EXISTS(SELECT 1 FROM person_erasure_locks WHERE receipt_id IS NOT NULL AND email=(WITH RECURSIVE fold(remaining,result) AS (\n SELECT trim(OLD.email), '' UNION ALL\n SELECT CAST(substr(CAST(remaining AS BLOB),max(1,length(CAST(substr(remaining,1,1) AS BLOB)))+1) AS TEXT),\n result || coalesce((SELECT folded FROM booking_search_casefold WHERE codepoint=unicode(remaining)),CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining,1,1) END)\n FROM fold WHERE length(CAST(remaining AS BLOB))>0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB))=0))\n)\nBEGIN SELECT RAISE(ABORT,'person_erasure_in_progress'); END","table":"oa_operators","type":"trigger"},{"name":"erasure_product_identity_admission","sql":"CREATE TRIGGER erasure_product_identity_admission BEFORE INSERT ON operators\nWHEN EXISTS(SELECT 1 FROM person_erasure_locks WHERE email=(WITH RECURSIVE fold(remaining,result) AS (\n SELECT trim(NEW.normalized_email), '' UNION ALL\n SELECT CAST(substr(CAST(remaining AS BLOB),max(1,length(CAST(substr(remaining,1,1) AS BLOB)))+1) AS TEXT),\n result || coalesce((SELECT folded FROM booking_search_casefold WHERE codepoint=unicode(remaining)),CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining,1,1) END)\n FROM fold WHERE length(CAST(remaining AS BLOB))>0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB))=0))\nBEGIN SELECT RAISE(ABORT,'person_erasure_in_progress'); END","table":"operators","type":"trigger"},{"name":"erasure_product_identity_change","sql":"CREATE TRIGGER erasure_product_identity_change BEFORE UPDATE OF normalized_email ON operators\nWHEN OLD.normalized_email IS NOT NEW.normalized_email AND (\n EXISTS(SELECT 1 FROM person_erasure_locks WHERE email=(WITH RECURSIVE fold(remaining,result) AS (\n SELECT trim(NEW.normalized_email), '' UNION ALL\n SELECT CAST(substr(CAST(remaining AS BLOB),max(1,length(CAST(substr(remaining,1,1) AS BLOB)))+1) AS TEXT),\n result || coalesce((SELECT folded FROM booking_search_casefold WHERE codepoint=unicode(remaining)),CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining,1,1) END)\n FROM fold WHERE length(CAST(remaining AS BLOB))>0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB))=0))\n OR EXISTS(SELECT 1 FROM person_erasure_locks WHERE receipt_id IS NOT NULL AND email=(WITH RECURSIVE fold(remaining,result) AS (\n SELECT trim(OLD.normalized_email), '' UNION ALL\n SELECT CAST(substr(CAST(remaining AS BLOB),max(1,length(CAST(substr(remaining,1,1) AS BLOB)))+1) AS TEXT),\n result || coalesce((SELECT folded FROM booking_search_casefold WHERE codepoint=unicode(remaining)),CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining,1,1) END)\n FROM fold WHERE length(CAST(remaining AS BLOB))>0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB))=0))\n)\nBEGIN SELECT RAISE(ABORT,'person_erasure_in_progress'); END","table":"operators","type":"trigger"},{"name":"erasure_request_admission","sql":"CREATE TRIGGER erasure_request_admission BEFORE INSERT ON availability_requests\nWHEN EXISTS(SELECT 1 FROM person_erasure_locks WHERE email=(WITH RECURSIVE fold(remaining,result) AS (\n SELECT trim(NEW.invitee_email), '' UNION ALL\n SELECT CAST(substr(CAST(remaining AS BLOB),max(1,length(CAST(substr(remaining,1,1) AS BLOB)))+1) AS TEXT),\n result || coalesce((SELECT folded FROM booking_search_casefold WHERE codepoint=unicode(remaining)),CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining,1,1) END)\n FROM fold WHERE length(CAST(remaining AS BLOB))>0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB))=0))\nBEGIN SELECT RAISE(ABORT,'person_erasure_in_progress'); END","table":"availability_requests","type":"trigger"},{"name":"erasure_request_identity_update","sql":"CREATE TRIGGER erasure_request_identity_update BEFORE UPDATE OF invitee_email ON availability_requests\nWHEN OLD.invitee_email IS NOT NEW.invitee_email AND EXISTS(SELECT 1 FROM person_erasure_locks WHERE email IN ((WITH RECURSIVE fold(remaining,result) AS (\n SELECT trim(OLD.invitee_email), '' UNION ALL\n SELECT CAST(substr(CAST(remaining AS BLOB),max(1,length(CAST(substr(remaining,1,1) AS BLOB)))+1) AS TEXT),\n result || coalesce((SELECT folded FROM booking_search_casefold WHERE codepoint=unicode(remaining)),CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining,1,1) END)\n FROM fold WHERE length(CAST(remaining AS BLOB))>0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB))=0),(WITH RECURSIVE fold(remaining,result) AS (\n SELECT trim(NEW.invitee_email), '' UNION ALL\n SELECT CAST(substr(CAST(remaining AS BLOB),max(1,length(CAST(substr(remaining,1,1) AS BLOB)))+1) AS TEXT),\n result || coalesce((SELECT folded FROM booking_search_casefold WHERE codepoint=unicode(remaining)),CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining,1,1) END)\n FROM fold WHERE length(CAST(remaining AS BLOB))>0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB))=0)))\nBEGIN SELECT RAISE(ABORT,'person_erasure_in_progress'); END","table":"availability_requests","type":"trigger"},{"name":"erasure_review_admission","sql":"CREATE TRIGGER erasure_review_admission BEFORE INSERT ON availability_request_review_nonces\nWHEN EXISTS(SELECT 1 FROM person_erasure_locks WHERE email=(WITH RECURSIVE fold(remaining,result) AS (\n SELECT trim(NEW.invitee_email), '' UNION ALL\n SELECT CAST(substr(CAST(remaining AS BLOB),max(1,length(CAST(substr(remaining,1,1) AS BLOB)))+1) AS TEXT),\n result || coalesce((SELECT folded FROM booking_search_casefold WHERE codepoint=unicode(remaining)),CASE WHEN unicode(remaining) IS NULL THEN char(0) ELSE substr(remaining,1,1) END)\n FROM fold WHERE length(CAST(remaining AS BLOB))>0\n) SELECT result FROM fold WHERE length(CAST(remaining AS BLOB))=0))\nBEGIN SELECT RAISE(ABORT,'person_erasure_in_progress'); END","table":"availability_request_review_nonces","type":"trigger"},{"name":"erasure_transfer_apply","sql":"CREATE TRIGGER erasure_transfer_apply BEFORE UPDATE OF phase ON rer_portability_jobs\nWHEN NEW.phase='applying' AND EXISTS(SELECT 1 FROM person_erasure_locks)\nBEGIN SELECT RAISE(ABORT,'person_erasure_in_progress'); END","table":"rer_portability_jobs","type":"trigger"},{"name":"erasure_transfer_start","sql":"CREATE TRIGGER erasure_transfer_start BEFORE INSERT ON rer_portability_jobs\nWHEN EXISTS(SELECT 1 FROM person_erasure_locks)\nBEGIN SELECT RAISE(ABORT,'person_erasure_in_progress'); END","table":"rer_portability_jobs","type":"trigger"},{"name":"event_booking_limits_delete","sql":"CREATE TRIGGER event_booking_limits_delete AFTER DELETE ON event_types BEGIN\n  DELETE FROM booking_limit_policies WHERE scope=OLD.id;\nEND","table":"event_types","type":"trigger"},{"name":"event_duration_options_insert","sql":"CREATE TRIGGER event_duration_options_insert AFTER INSERT ON event_types\nWHEN NEW.duration_options_json = '[]'\nBEGIN UPDATE event_types SET duration_options_json = json_array(NEW.duration_minutes) WHERE id = NEW.id; END","table":"event_types","type":"trigger"},{"name":"event_questions_position_idx","sql":"CREATE UNIQUE INDEX event_questions_position_idx ON event_questions(event_type_id, position)","table":"event_questions","type":"index"},{"name":"event_questions_public_key_idx","sql":"CREATE UNIQUE INDEX event_questions_public_key_idx ON event_questions(event_type_id, public_key)","table":"event_questions","type":"index"},{"name":"event_schedule_bindings_schedule","sql":"CREATE INDEX event_schedule_bindings_schedule ON event_schedule_bindings(schedule_id)","table":"event_schedule_bindings","type":"index"},{"name":"ext_custom_fields_booking_idx","sql":"CREATE INDEX ext_custom_fields_booking_idx ON ext_custom_field_values(booking_id)","table":"ext_custom_field_values","type":"index"},{"name":"ext_custom_fields_entity_idx","sql":"CREATE INDEX ext_custom_fields_entity_idx ON ext_custom_field_definitions(entity)","table":"ext_custom_field_definitions","type":"index"},{"name":"ext_custom_fields_event_idx","sql":"CREATE INDEX ext_custom_fields_event_idx ON ext_custom_field_values(event_type_id)","table":"ext_custom_field_values","type":"index"},{"name":"ext_custom_fields_request_idx","sql":"CREATE INDEX ext_custom_fields_request_idx ON ext_custom_field_values(request_id)","table":"ext_custom_field_values","type":"index"},{"name":"host_link_copy_event_changed","sql":"CREATE TRIGGER host_link_copy_event_changed AFTER UPDATE OF slug, status, request_only, alternative_requests_enabled ON event_types\nWHEN OLD.slug IS NOT NEW.slug OR OLD.status IS NOT NEW.status OR OLD.request_only IS NOT NEW.request_only OR OLD.alternative_requests_enabled IS NOT NEW.alternative_requests_enabled\nBEGIN\n  DELETE FROM host_link_copy_reports WHERE event_type_id = NEW.id;\nEND","table":"event_types","type":"trigger"},{"name":"host_link_copy_profile_changed","sql":"CREATE TRIGGER host_link_copy_profile_changed AFTER UPDATE OF handle, name, timezone ON host_profiles\nWHEN OLD.handle IS NOT NEW.handle OR OLD.name IS NOT NEW.name OR OLD.timezone IS NOT NEW.timezone\nBEGIN\n  DELETE FROM host_link_copy_reports;\nEND","table":"host_profiles","type":"trigger"},{"name":"host_link_copy_profile_deleted","sql":"CREATE TRIGGER host_link_copy_profile_deleted AFTER DELETE ON host_profiles\nBEGIN\n  DELETE FROM host_link_copy_reports;\nEND","table":"host_profiles","type":"trigger"},{"name":"ik_active_target","sql":"CREATE UNIQUE INDEX ik_active_target ON ik_provenance(destination,target_kind,target_id) WHERE reversed=0","table":"ik_provenance","type":"index"},{"name":"ik_d1_creation_plan_capture","sql":"CREATE TRIGGER ik_d1_creation_plan_capture AFTER INSERT ON ik_d1_plan_chunks BEGIN INSERT INTO ik_d1_creation_plans(job_id,ordinal,body) VALUES(NEW.job_id,NEW.ordinal,NEW.body); END","table":"ik_d1_plan_chunks","type":"trigger"},{"name":"ik_d1_creation_plan_immutable","sql":"CREATE TRIGGER ik_d1_creation_plan_immutable BEFORE UPDATE ON ik_d1_creation_plans WHEN NEW.job_id IS NOT OLD.job_id OR NEW.ordinal IS NOT OLD.ordinal OR NEW.body IS NOT OLD.body OR OLD.released<>0 OR NEW.released<>1 OR NOT EXISTS(SELECT 1 FROM ik_d1_plan_chunks p WHERE p.job_id=OLD.job_id AND p.ordinal=OLD.ordinal AND p.body IS OLD.body) BEGIN SELECT RAISE(ABORT,'IMPORT_CREATION_SNAPSHOT_CHANGED'); END","table":"ik_d1_creation_plans","type":"trigger"},{"name":"ik_d1_creation_plan_release","sql":"CREATE TRIGGER ik_d1_creation_plan_release BEFORE DELETE ON ik_d1_creation_plans WHEN OLD.released<>1 BEGIN SELECT RAISE(ABORT,'IMPORT_CREATION_SNAPSHOT_CHANGED'); END","table":"ik_d1_creation_plans","type":"trigger"},{"name":"ik_d1_custody_chunks_delete","sql":"CREATE TRIGGER ik_d1_custody_chunks_delete AFTER DELETE ON ik_d1_plan_chunks BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_plan_chunks","type":"trigger"},{"name":"ik_d1_custody_chunks_insert","sql":"CREATE TRIGGER ik_d1_custody_chunks_insert AFTER INSERT ON ik_d1_plan_chunks BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_d1_plan_chunks","type":"trigger"},{"name":"ik_d1_custody_chunks_update","sql":"CREATE TRIGGER ik_d1_custody_chunks_update AFTER UPDATE ON ik_d1_plan_chunks BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_plan_chunks","type":"trigger"},{"name":"ik_d1_custody_job_insert","sql":"CREATE TRIGGER ik_d1_custody_job_insert AFTER INSERT ON ik_jobs BEGIN INSERT INTO ik_d1_custody_revisions(job_id) VALUES(NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_custody_job_update","sql":"CREATE TRIGGER ik_d1_custody_job_update AFTER UPDATE OF plan_json ON ik_jobs BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=OLD.id OR job_id=NEW.id; END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_custody_receipt_insert","sql":"CREATE TRIGGER ik_d1_custody_receipt_insert BEFORE INSERT ON ik_d1_custody_revisions WHEN NEW.seal IS NOT NULL AND NOT EXISTS(SELECT 1 FROM ik_d1_publication_fences WHERE job_id=NEW.job_id AND stream_id=NEW.seal) BEGIN SELECT RAISE(ABORT,'IMPORT_PUBLICATION_RECEIPT_CHANGED'); END","table":"ik_d1_custody_revisions","type":"trigger"},{"name":"ik_d1_custody_receipt_revision","sql":"CREATE TRIGGER ik_d1_custody_receipt_revision AFTER UPDATE OF revision ON ik_d1_custody_revisions BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=NEW.job_id; END","table":"ik_d1_custody_revisions","type":"trigger"},{"name":"ik_d1_custody_receipt_seal","sql":"CREATE TRIGGER ik_d1_custody_receipt_seal BEFORE UPDATE OF seal ON ik_d1_custody_revisions WHEN NEW.seal IS NOT NULL AND NOT EXISTS(SELECT 1 FROM ik_d1_publication_fences WHERE job_id=NEW.job_id AND stream_id=NEW.seal) BEGIN SELECT RAISE(ABORT,'IMPORT_PUBLICATION_RECEIPT_CHANGED'); END","table":"ik_d1_custody_revisions","type":"trigger"},{"name":"ik_d1_custody_state_create","sql":"CREATE TRIGGER ik_d1_custody_state_create AFTER INSERT ON ik_jobs BEGIN INSERT INTO ik_d1_custody_states(job_id) VALUES(NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_custody_state_delete","sql":"CREATE TRIGGER ik_d1_custody_state_delete BEFORE DELETE ON ik_d1_custody_states WHEN EXISTS(SELECT 1 FROM ik_jobs WHERE id=OLD.job_id) BEGIN SELECT RAISE(ABORT,'IMPORT_CUSTODY_STATE_CHANGED'); END","table":"ik_d1_custody_states","type":"trigger"},{"name":"ik_d1_custody_state_ik_batches_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_batches_delete AFTER DELETE ON ik_batches BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_batches","type":"trigger"},{"name":"ik_d1_custody_state_ik_batches_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_batches_insert AFTER INSERT ON ik_batches BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_batches","type":"trigger"},{"name":"ik_d1_custody_state_ik_batches_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_batches_update AFTER UPDATE ON ik_batches BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_batches","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_creation_plans_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_creation_plans_delete AFTER DELETE ON ik_d1_creation_plans BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_creation_plans","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_creation_plans_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_creation_plans_insert AFTER INSERT ON ik_d1_creation_plans BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_d1_creation_plans","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_creation_plans_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_creation_plans_update AFTER UPDATE ON ik_d1_creation_plans BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_creation_plans","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_entries_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_entries_delete AFTER DELETE ON ik_d1_entries BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_entries","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_entries_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_entries_insert AFTER INSERT ON ik_d1_entries BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_d1_entries","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_entries_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_entries_update AFTER UPDATE ON ik_d1_entries BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_entries","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_sources_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_sources_delete AFTER DELETE ON ik_d1_erased_sources BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE i.source_identity=OLD.identity AND j.destination=OLD.destination); END","table":"ik_d1_erased_sources","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_sources_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_sources_insert AFTER INSERT ON ik_d1_erased_sources BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE i.source_identity=NEW.identity AND j.destination=NEW.destination); END","table":"ik_d1_erased_sources","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_sources_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_sources_update AFTER UPDATE ON ik_d1_erased_sources BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE (i.source_identity=OLD.identity AND j.destination=OLD.destination) OR (i.source_identity=NEW.identity AND j.destination=NEW.destination)); END","table":"ik_d1_erased_sources","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_targets_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_targets_delete AFTER DELETE ON ik_d1_erased_targets BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE i.target_identity=OLD.identity AND j.destination=OLD.destination); END","table":"ik_d1_erased_targets","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_targets_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_targets_insert AFTER INSERT ON ik_d1_erased_targets BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE i.target_identity=NEW.identity AND j.destination=NEW.destination); END","table":"ik_d1_erased_targets","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_targets_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_targets_update AFTER UPDATE ON ik_d1_erased_targets BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE (i.target_identity=OLD.identity AND j.destination=OLD.destination) OR (i.target_identity=NEW.identity AND j.destination=NEW.destination)); END","table":"ik_d1_erased_targets","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_history_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_history_delete AFTER DELETE ON ik_d1_history BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_history","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_history_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_history_insert AFTER INSERT ON ik_d1_history BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_d1_history","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_history_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_history_update AFTER UPDATE ON ik_d1_history BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_history","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_indexed_jobs_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_indexed_jobs_delete AFTER DELETE ON ik_d1_indexed_jobs BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_indexed_jobs","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_indexed_jobs_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_indexed_jobs_insert AFTER INSERT ON ik_d1_indexed_jobs BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 