ble":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_receipt_stream_update","sql":"CREATE TRIGGER ik_d1_receipt_stream_update BEFORE UPDATE ON ik_d1_streams BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id IN (SELECT job_id FROM ik_d1_stream_pages WHERE stream_id=OLD.id); END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_retirement_delete","sql":"CREATE TRIGGER ik_d1_retirement_delete BEFORE DELETE ON ik_d1_retirements BEGIN SELECT RAISE(ABORT,'IMPORT_RETIREMENT_CHANGED'); END","table":"ik_d1_retirements","type":"trigger"},{"name":"ik_d1_retirement_insert","sql":"CREATE TRIGGER ik_d1_retirement_insert BEFORE INSERT ON ik_d1_retirements WHEN EXISTS(SELECT 1 FROM ik_d1_retirements WHERE id=NEW.id AND kind=NEW.kind) BEGIN SELECT RAISE(ABORT,'IMPORT_RETIREMENT_CHANGED'); END","table":"ik_d1_retirements","type":"trigger"},{"name":"ik_d1_retirement_update","sql":"CREATE TRIGGER ik_d1_retirement_update BEFORE UPDATE ON ik_d1_retirements BEGIN SELECT RAISE(ABORT,'IMPORT_RETIREMENT_CHANGED'); END","table":"ik_d1_retirements","type":"trigger"},{"name":"ik_d1_staging_binding","sql":"CREATE TRIGGER ik_d1_staging_binding BEFORE UPDATE OF id,generation,destination,namespace,mapping_version,principal_id,fingerprint,operation_key,total,pages,layout_hash,reversal_policy ON ik_d1_staging BEGIN SELECT RAISE(ABORT,'IMPORT_STAGE_BINDING_CHANGED'); END","table":"ik_d1_staging","type":"trigger"},{"name":"ik_d1_staging_chunks_delete","sql":"CREATE TRIGGER ik_d1_staging_chunks_delete AFTER DELETE ON ik_d1_staging_chunks BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=OLD.stage_id; END","table":"ik_d1_staging_chunks","type":"trigger"},{"name":"ik_d1_staging_chunks_insert","sql":"CREATE TRIGGER ik_d1_staging_chunks_insert AFTER INSERT ON ik_d1_staging_chunks BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=NEW.stage_id; END","table":"ik_d1_staging_chunks","type":"trigger"},{"name":"ik_d1_staging_chunks_registered","sql":"CREATE TRIGGER ik_d1_staging_chunks_registered BEFORE INSERT ON ik_d1_staging_chunks WHEN NOT EXISTS(SELECT 1 FROM ik_d1_staging WHERE id=NEW.stage_id AND registered_revision IS NOT NULL) BEGIN SELECT RAISE(ABORT,'IMPORT_STAGE_INDEX_REQUIRED'); END","table":"ik_d1_staging_chunks","type":"trigger"},{"name":"ik_d1_staging_chunks_update","sql":"CREATE TRIGGER ik_d1_staging_chunks_update AFTER UPDATE ON ik_d1_staging_chunks BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=OLD.stage_id OR id=NEW.stage_id; END","table":"ik_d1_staging_chunks","type":"trigger"},{"name":"ik_d1_staging_headers_delete","sql":"CREATE TRIGGER ik_d1_staging_headers_delete AFTER DELETE ON ik_d1_staging_headers BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=OLD.stage_id; END","table":"ik_d1_staging_headers","type":"trigger"},{"name":"ik_d1_staging_headers_insert","sql":"CREATE TRIGGER ik_d1_staging_headers_insert AFTER INSERT ON ik_d1_staging_headers BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=NEW.stage_id; END","table":"ik_d1_staging_headers","type":"trigger"},{"name":"ik_d1_staging_headers_registered","sql":"CREATE TRIGGER ik_d1_staging_headers_registered BEFORE INSERT ON ik_d1_staging_headers WHEN NOT EXISTS(SELECT 1 FROM ik_d1_staging WHERE id=NEW.stage_id AND registered_revision IS NOT NULL) BEGIN SELECT RAISE(ABORT,'IMPORT_STAGE_INDEX_REQUIRED'); END","table":"ik_d1_staging_headers","type":"trigger"},{"name":"ik_d1_staging_headers_update","sql":"CREATE TRIGGER ik_d1_staging_headers_update AFTER UPDATE ON ik_d1_staging_headers BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=OLD.stage_id OR id=NEW.stage_id; END","table":"ik_d1_staging_headers","type":"trigger"},{"name":"ik_d1_staging_index_custody_delete","sql":"CREATE TRIGGER ik_d1_staging_index_custody_delete AFTER DELETE ON ik_d1_staging_index WHEN EXISTS(SELECT 1 FROM ik_d1_staging_chunks WHERE stage_id=OLD.stage_id) OR EXISTS(SELECT 1 FROM ik_d1_staging_originals WHERE stage_id=OLD.stage_id) BEGIN DELETE FROM ik_d1_staging_chunks WHERE stage_id=OLD.stage_id; DELETE FROM ik_d1_staging_originals WHERE stage_id=OLD.stage_id; END","table":"ik_d1_staging_index","type":"trigger"},{"name":"ik_d1_staging_index_custody_insert","sql":"CREATE TRIGGER ik_d1_staging_index_custody_insert AFTER INSERT ON ik_d1_staging_index WHEN EXISTS(SELECT 1 FROM ik_d1_staging_chunks WHERE stage_id=NEW.stage_id) OR EXISTS(SELECT 1 FROM ik_d1_staging_originals WHERE stage_id=NEW.stage_id) BEGIN DELETE FROM ik_d1_staging_chunks WHERE stage_id=NEW.stage_id; DELETE FROM ik_d1_staging_originals WHERE stage_id=NEW.stage_id; END","table":"ik_d1_staging_index","type":"trigger"},{"name":"ik_d1_staging_index_custody_update","sql":"CREATE TRIGGER ik_d1_staging_index_custody_update AFTER UPDATE ON ik_d1_staging_index WHEN EXISTS(SELECT 1 FROM ik_d1_staging_chunks WHERE stage_id=OLD.stage_id OR stage_id=NEW.stage_id) OR EXISTS(SELECT 1 FROM ik_d1_staging_originals WHERE stage_id=OLD.stage_id OR stage_id=NEW.stage_id) BEGIN DELETE FROM ik_d1_staging_chunks WHERE stage_id=OLD.stage_id OR stage_id=NEW.stage_id; DELETE FROM ik_d1_staging_originals WHERE stage_id=OLD.stage_id OR stage_id=NEW.stage_id; END","table":"ik_d1_staging_index","type":"trigger"},{"name":"ik_d1_staging_index_delete","sql":"CREATE TRIGGER ik_d1_staging_index_delete AFTER DELETE ON ik_d1_staging_index BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=OLD.stage_id; END","table":"ik_d1_staging_index","type":"trigger"},{"name":"ik_d1_staging_index_insert","sql":"CREATE TRIGGER ik_d1_staging_index_insert AFTER INSERT ON ik_d1_staging_index BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=NEW.stage_id; END","table":"ik_d1_staging_index","type":"trigger"},{"name":"ik_d1_staging_index_update","sql":"CREATE TRIGGER ik_d1_staging_index_update AFTER UPDATE ON ik_d1_staging_index BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=OLD.stage_id OR id=NEW.stage_id; END","table":"ik_d1_staging_index","type":"trigger"},{"name":"ik_d1_staging_originals_delete","sql":"CREATE TRIGGER ik_d1_staging_originals_delete AFTER DELETE ON ik_d1_staging_originals BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=OLD.stage_id; END","table":"ik_d1_staging_originals","type":"trigger"},{"name":"ik_d1_staging_originals_insert","sql":"CREATE TRIGGER ik_d1_staging_originals_insert AFTER INSERT ON ik_d1_staging_originals BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=NEW.stage_id; END","table":"ik_d1_staging_originals","type":"trigger"},{"name":"ik_d1_staging_originals_registered","sql":"CREATE TRIGGER ik_d1_staging_originals_registered BEFORE INSERT ON ik_d1_staging_originals WHEN NOT EXISTS(SELECT 1 FROM ik_d1_staging WHERE id=NEW.stage_id AND registered_revision IS NOT NULL) BEGIN SELECT RAISE(ABORT,'IMPORT_STAGE_INDEX_REQUIRED'); END","table":"ik_d1_staging_originals","type":"trigger"},{"name":"ik_d1_staging_originals_update","sql":"CREATE TRIGGER ik_d1_staging_originals_update AFTER UPDATE ON ik_d1_staging_originals BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL WHERE id=OLD.stage_id OR id=NEW.stage_id; END","table":"ik_d1_staging_originals","type":"trigger"},{"name":"ik_d1_staging_pages_delete","sql":"CREATE TRIGGER ik_d1_staging_pages_delete AFTER DELETE ON ik_d1_staging_pages BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=OLD.stage_id; END","table":"ik_d1_staging_pages","type":"trigger"},{"name":"ik_d1_staging_pages_insert","sql":"CREATE TRIGGER ik_d1_staging_pages_insert AFTER INSERT ON ik_d1_staging_pages BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=NEW.stage_id; END","table":"ik_d1_staging_pages","type":"trigger"},{"name":"ik_d1_staging_pages_update","sql":"CREATE TRIGGER ik_d1_staging_pages_update AFTER UPDATE ON ik_d1_staging_pages BEGIN UPDATE ik_d1_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=OLD.stage_id OR id=NEW.stage_id; END","table":"ik_d1_staging_pages","type":"trigger"},{"name":"ik_d1_staging_source","sql":"CREATE INDEX ik_d1_staging_source ON ik_d1_staging_index(source_identity,stage_id)","table":"ik_d1_staging_index","type":"index"},{"name":"ik_d1_staging_target","sql":"CREATE INDEX ik_d1_staging_target ON ik_d1_staging_index(target_identity,stage_id)","table":"ik_d1_staging_index","type":"index"},{"name":"ik_d1_stream_origin_delete","sql":"CREATE TRIGGER ik_d1_stream_origin_delete BEFORE DELETE ON ik_d1_stream_origins WHEN EXISTS(SELECT 1 FROM ik_jobs WHERE id=OLD.job_id) BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_ORIGIN_CHANGED'); END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_origin_insert","sql":"CREATE TRIGGER ik_d1_stream_origin_insert BEFORE INSERT ON ik_d1_stream_origins WHEN EXISTS(SELECT 1 FROM ik_d1_stream_origins WHERE job_id=NEW.job_id) OR NOT EXISTS(SELECT 1 FROM ik_d1_stream_pages p JOIN ik_d1_streams s ON s.id=p.stream_id JOIN ik_jobs j ON j.id=p.job_id WHERE ((((NEW.job_id IS p.job_id AND NEW.stream_id IS s.id) AND (NEW.ordinal IS p.ordinal AND NEW.page_total IS p.total)) AND ((NEW.job_operation_key IS j.operation_key AND NEW.parent_destination IS s.destination) AND (NEW.parent_namespace IS s.namespace AND (NEW.parent_mapping_version IS s.mapping_version AND NEW.parent_principal_id IS s.principal_id)))) AND (((NEW.parent_fingerprint IS s.fingerprint AND NEW.parent_operation_key IS s.operation_key) AND (NEW.parent_total IS s.total AND (NEW.parent_layout_hash IS s.layout_hash AND p.stream_id IS s.id))) AND ((j.total IS p.total AND j.destination IS s.destination) AND (j.namespace IS s.namespace AND (j.mapping_version IS s.mapping_version AND j.principal_id IS s.principal_id)))))) BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_ORIGIN_CHANGED'); END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_origin_job_delete","sql":"CREATE TRIGGER ik_d1_stream_origin_job_delete AFTER DELETE ON ik_jobs BEGIN DELETE FROM ik_d1_stream_origins WHERE job_id=OLD.id; END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_stream_origin_page_insert","sql":"CREATE TRIGGER ik_d1_stream_origin_page_insert AFTER INSERT ON ik_d1_stream_pages BEGIN INSERT INTO ik_d1_stream_origins(job_id,stream_id,ordinal,page_total,job_operation_key,parent_destination,parent_namespace,parent_mapping_version,parent_principal_id,parent_fingerprint,parent_operation_key,parent_total,parent_layout_hash) SELECT p.job_id,s.id,p.ordinal,p.total,j.operation_key,s.destination,s.namespace,s.mapping_version,s.principal_id,s.fingerprint,s.operation_key,s.total,s.layout_hash FROM ik_d1_stream_pages p JOIN ik_d1_streams s ON s.id=p.stream_id JOIN ik_jobs j ON j.id=p.job_id WHERE NOT EXISTS(SELECT 1 FROM ik_d1_stream_origins o WHERE o.job_id=p.job_id) AND j.total IS p.total AND j.destination IS s.destination AND j.namespace IS s.namespace AND j.mapping_version IS s.mapping_version AND j.principal_id IS s.principal_id AND p.job_id=NEW.job_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_origin_page_update","sql":"CREATE TRIGGER ik_d1_stream_origin_page_update AFTER UPDATE OF stream_id,ordinal,job_id,total ON ik_d1_stream_pages BEGIN INSERT INTO ik_d1_stream_origins(job_id,stream_id,ordinal,page_total,job_operation_key,parent_destination,parent_namespace,parent_mapping_version,parent_principal_id,parent_fingerprint,parent_operation_key,parent_total,parent_layout_hash) SELECT p.job_id,s.id,p.ordinal,p.total,j.operation_key,s.destination,s.namespace,s.mapping_version,s.principal_id,s.fingerprint,s.operation_key,s.total,s.layout_hash FROM ik_d1_stream_pages p JOIN ik_d1_streams s ON s.id=p.stream_id JOIN ik_jobs j ON j.id=p.job_id WHERE NOT EXISTS(SELECT 1 FROM ik_d1_stream_origins o WHERE o.job_id=p.job_id) AND j.total IS p.total AND j.destination IS s.destination AND j.namespace IS s.namespace AND j.mapping_version IS s.mapping_version AND j.principal_id IS s.principal_id AND p.job_id=NEW.job_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_origin_parent","sql":"CREATE INDEX ik_d1_stream_origin_parent ON ik_d1_stream_origins(stream_id,ordinal)","table":"ik_d1_stream_origins","type":"index"},{"name":"ik_d1_stream_origin_update","sql":"CREATE TRIGGER ik_d1_stream_origin_update BEFORE UPDATE ON ik_d1_stream_origins BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_ORIGIN_CHANGED'); END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_page_delete","sql":"CREATE TRIGGER ik_d1_stream_page_delete AFTER DELETE ON ik_d1_stream_pages BEGIN UPDATE ik_d1_streams SET state='invalid' WHERE id=OLD.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_page_insert","sql":"CREATE TRIGGER ik_d1_stream_page_insert AFTER INSERT ON ik_d1_stream_pages BEGIN UPDATE ik_d1_streams SET state='invalid' WHERE id=NEW.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_page_update","sql":"CREATE TRIGGER ik_d1_stream_page_update AFTER UPDATE OF stream_id,ordinal,job_id,total ON ik_d1_stream_pages BEGIN UPDATE ik_d1_streams SET state='invalid' WHERE id=OLD.stream_id OR id=NEW.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_revision_delete","sql":"CREATE TRIGGER ik_d1_stream_revision_delete BEFORE DELETE ON ik_d1_stream_revisions BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_REVISION_CHANGED'); END","table":"ik_d1_stream_revisions","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_origins_delete","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_origins_delete AFTER DELETE ON ik_d1_stream_origins BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.stream_id; END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_origins_insert","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_origins_insert AFTER INSERT ON ik_d1_stream_origins BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=NEW.stream_id; END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_origins_update","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_origins_update AFTER UPDATE ON ik_d1_stream_origins BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.stream_id OR stream_id=NEW.stream_id; END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_pages_delete","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_pages_delete AFTER DELETE ON ik_d1_stream_pages BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_pages_insert","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_pages_insert AFTER INSERT ON ik_d1_stream_pages BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=NEW.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_pages_update","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_pages_update AFTER UPDATE OF stream_id,ordinal,job_id,total ON ik_d1_stream_pages BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.stream_id OR stream_id=NEW.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_revision_insert","sql":"CREATE TRIGGER ik_d1_stream_revision_insert BEFORE INSERT ON ik_d1_stream_revisions WHEN EXISTS(SELECT 1 FROM ik_d1_stream_revisions WHERE stream_id=NEW.stream_id) BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_REVISION_CHANGED'); END","table":"ik_d1_stream_revisions","type":"trigger"},{"name":"ik_d1_stream_revision_job_delete","sql":"CREATE TRIGGER ik_d1_stream_revision_job_delete AFTER DELETE ON ik_jobs BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id IN (SELECT stream_id FROM ik_d1_stream_pages WHERE job_id=OLD.id UNION SELECT stream_id FROM ik_d1_stream_origins WHERE job_id=OLD.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_stream_revision_job_insert","sql":"CREATE TRIGGER ik_d1_stream_revision_job_insert AFTER INSERT ON ik_jobs BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id IN (SELECT stream_id FROM ik_d1_stream_pages WHERE job_id=NEW.id UNION SELECT stream_id FROM ik_d1_stream_origins WHERE job_id=NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_stream_revision_job_layout","sql":"CREATE TRIGGER ik_d1_stream_revision_job_layout AFTER UPDATE OF id,destination,namespace,mapping_version,principal_id,fingerprint,operation_key,total,reversal_policy,reversal_policy_hash ON ik_jobs BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id IN (SELECT stream_id FROM ik_d1_stream_pages WHERE job_id=OLD.id OR job_id=NEW.id UNION SELECT stream_id FROM ik_d1_stream_origins WHERE job_id=OLD.id OR job_id=NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_stream_revision_job_update","sql":"CREATE TRIGGER ik_d1_stream_revision_job_update AFTER UPDATE ON ik_jobs BEGIN UPDATE ik_d1_stream_revisions SET progress_revision=progress_revision+1 WHERE stream_id IN (SELECT stream_id FROM ik_d1_stream_pages WHERE job_id=OLD.id OR job_id=NEW.id UNION SELECT stream_id FROM ik_d1_stream_origins WHERE job_id=OLD.id OR job_id=NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_stream_revision_page_erasure","sql":"CREATE TRIGGER ik_d1_stream_revision_page_erasure AFTER UPDATE OF erased_records ON ik_d1_stream_pages BEGIN UPDATE ik_d1_stream_revisions SET progress_revision=progress_revision+1 WHERE stream_id=OLD.stream_id OR stream_id=NEW.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_revision_parent_delete","sql":"CREATE TRIGGER ik_d1_stream_revision_parent_delete AFTER DELETE ON ik_d1_streams BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.id; END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_stream_revision_parent_insert","sql":"CREATE TRIGGER ik_d1_stream_revision_parent_insert AFTER INSERT ON ik_d1_streams BEGIN INSERT INTO ik_d1_stream_revisions(stream_id,destination,namespace,mapping_version,principal_id,fingerprint,operation_key,total,layout_hash) SELECT NEW.id,NEW.destination,NEW.namespace,NEW.mapping_version,NEW.principal_id,NEW.fingerprint,NEW.operation_key,NEW.total,NEW.layout_hash WHERE NOT EXISTS(SELECT 1 FROM ik_d1_stream_revisions WHERE stream_id=NEW.id); UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=NEW.id; END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_stream_revision_parent_layout","sql":"CREATE TRIGGER ik_d1_stream_revision_parent_layout AFTER UPDATE OF id,destination,namespace,mapping_version,principal_id,fingerprint,operation_key,total,layout_hash ON ik_d1_streams BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.id OR stream_id=NEW.id; END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_stream_revision_parent_update","sql":"CREATE TRIGGER ik_d1_stream_revision_parent_update AFTER UPDATE ON ik_d1_streams BEGIN UPDATE ik_d1_stream_revisions SET progress_revision=progress_revision+1 WHERE stream_id=OLD.id OR stream_id=NEW.id; END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_stream_revision_update","sql":"CREATE TRIGGER ik_d1_stream_revision_update BEFORE UPDATE ON ik_d1_stream_revisions WHEN NEW.stream_id IS NOT OLD.stream_id OR NEW.destination IS NOT OLD.destination OR NEW.mapping_version IS NOT OLD.mapping_version OR NEW.principal_id IS NOT OLD.principal_id OR NEW.fingerprint IS NOT OLD.fingerprint OR NEW.total IS NOT OLD.total OR NEW.layout_hash IS NOT OLD.layout_hash OR NEW.layout_revision<OLD.layout_revision OR NEW.progress_revision<=OLD.progress_revision OR ((NEW.namespace IS NOT OLD.namespace OR NEW.operation_key IS NOT OLD.operation_key) AND NOT (NEW.namespace='' AND NEW.operation_key='' AND NOT EXISTS(SELECT 1 FROM ik_d1_streams WHERE id=OLD.stream_id) AND EXISTS(SELECT 1 FROM ik_d1_retirements WHERE id=OLD.stream_id AND kind='stream'))) BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_REVISION_CHANGED'); END","table":"ik_d1_stream_revisions","type":"trigger"},{"name":"ik_provenance_job","sql":"CREATE INDEX ik_provenance_job ON ik_provenance(job_id,reversed,ordinal,effect_ordinal)","table":"ik_provenance","type":"index"},{"name":"ik_provenance_source","sql":"CREATE INDEX ik_provenance_source ON ik_provenance(source_identity,reversed)","table":"ik_provenance","type":"index"},{"name":"ik_sources_job","sql":"CREATE INDEX ik_sources_job ON ik_sources(job_id)","table":"ik_sources","type":"index"},{"name":"magic_link_tokens_operator_id_idx","sql":"CREATE INDEX magic_link_tokens_operator_id_idx ON magic_link_tokens(operator_id)","table":"magic_link_tokens","type":"index"},{"name":"move_in_differences_booking","sql":"CREATE INDEX move_in_differences_booking ON move_in_differences(booking_id)","table":"move_in_differences","type":"index"},{"name":"oa_first_setup_provider_setting","sql":"CREATE TRIGGER oa_first_setup_provider_setting AFTER INSERT ON oa_bootstrap BEGIN\n INSERT INTO oa_auth_settings(singleton,idp_sign_in,generation,first_setup) VALUES(1,0,0,1) ON CONFLICT DO NOTHING;\nEND","table":"oa_bootstrap","type":"trigger"},{"name":"oa_native_claim_closes_provider_setup","sql":"CREATE TRIGGER oa_native_claim_closes_provider_setup AFTER INSERT ON oa_sessions\nWHEN NEW.kind='native' AND NOT EXISTS(SELECT 1 FROM oa_sessions WHERE operator_id=NEW.operator_id AND id!=NEW.id) AND EXISTS(SELECT 1 FROM oa_bootstrap WHERE claim_id=NEW.operator_id AND claimed_at=NEW.created_at)\nBEGIN\n UPDATE oa_auth_settings SET first_setup=0 WHERE singleton=1 AND NOT EXISTS(\n  SELECT 1 FROM oa_setup_links WHERE interface='oidc-provider@1' AND completed=0 AND owner_id IS NULL AND expires_at>NEW.created_at\n );\n UPDATE oa_setup_links SET owner_id=NEW.operator_id,owner_version=NEW.operator_version,session_id=NEW.id\n WHERE owner_id IS NULL AND completed=0 AND expires_at>NEW.created_at;\nEND","table":"oa_sessions","type":"trigger"},{"name":"oa_operator_version","sql":"CREATE TRIGGER oa_operator_version AFTER UPDATE OF status,role ON oa_operators\n WHEN OLD.status != NEW.status OR OLD.role != NEW.role\n BEGIN UPDATE oa_operators SET version=OLD.version+1 WHERE id=NEW.id; END","table":"oa_operators","type":"trigger"},{"name":"oa_preserve_last_owner_delete","sql":"CREATE TRIGGER oa_preserve_last_owner_delete BEFORE DELETE ON oa_operators\n WHEN OLD.role='owner' AND OLD.status='active'\n AND (SELECT COUNT(*) FROM oa_operators WHERE role='owner' AND status='active') <= 1\n BEGIN SELECT RAISE(ABORT, 'last_owner'); END","table":"oa_operators","type":"trigger"},{"name":"oa_preserve_last_owner_update","sql":"CREATE TRIGGER oa_preserve_last_owner_update BEFORE UPDATE OF status,role ON oa_operators\n WHEN OLD.role='owner' AND OLD.status='active' AND (NEW.role!='owner' OR NEW.status!='active')\n AND (SELECT COUNT(*) FROM oa_operators WHERE role='owner' AND status='active') <= 1\n BEGIN SELECT RAISE(ABORT, 'last_owner'); END","table":"oa_operators","type":"trigger"},{"name":"oa_provider_session_identity","sql":"CREATE INDEX oa_provider_session_identity ON oa_provider_sessions(issuer,subject,sid)","table":"oa_provider_sessions","type":"index"},{"name":"oa_record_invitation_cancellation","sql":"CREATE TRIGGER oa_record_invitation_cancellation AFTER UPDATE OF status ON oa_operators\n WHEN OLD.status='invited' AND NEW.status='inactive'\n BEGIN INSERT INTO oa_invitation_cancellations(operator_id,operator_version)\n VALUES(NEW.id,OLD.version+1)\n ON CONFLICT(operator_id) DO UPDATE SET operator_version=excluded.operator_version; END","table":"oa_operators","type":"trigger"},{"name":"oa_reject_cancelled_invitation_reactivation","sql":"CREATE TRIGGER oa_reject_cancelled_invitation_reactivation BEFORE UPDATE OF status ON oa_operators\n WHEN NEW.status='active' AND EXISTS(SELECT 1 FROM oa_invitation_cancellations WHERE operator_id=OLD.id)\n BEGIN SELECT RAISE(ABORT, 'invitation_required'); END","table":"oa_operators","type":"trigger"},{"name":"oa_sessions_operator","sql":"CREATE INDEX oa_sessions_operator ON oa_sessions(operator_id)","table":"oa_sessions","type":"index"},{"name":"oa_step_up_session","sql":"CREATE INDEX oa_step_up_session ON oa_step_up_challenges(session_id)","table":"oa_step_up_challenges","type":"index"},{"name":"oc_owner_claim_empty_store","sql":"CREATE TRIGGER oc_owner_claim_empty_store BEFORE INSERT ON oc_owner_claims\nWHEN EXISTS(SELECT 1 FROM oa_bootstrap) OR EXISTS(SELECT 1 FROM oa_operators)\nBEGIN\n  SELECT RAISE(ABORT, 'owner_claim_already_initialized');\nEND","table":"oc_owner_claims","type":"trigger"},{"name":"operator_access_revoked","sql":"CREATE TRIGGER operator_access_revoked AFTER UPDATE OF removed_at ON operators\nWHEN NEW.removed_at IS NOT NULL AND OLD.removed_at IS NULL\nBEGIN\n  UPDATE operator_sessions SET revoked_at = NEW.removed_at, updated_at = NEW.removed_at\n    WHERE operator_id = NEW.id AND revoked_at IS NULL;\n  UPDATE magic_link_tokens SET consumed_at = NEW.removed_at, updated_at = NEW.removed_at\n    WHERE operator_id = NEW.id AND consumed_at IS NULL;\nEND","table":"operators","type":"trigger"},{"name":"operator_creation_erasure_guard","sql":"CREATE TRIGGER operator_creation_erasure_guard\nBEFORE DELETE ON bookings\nBEGIN\n  INSERT OR IGNORE INTO operator_creation_tombstones (key_hash, operator_id, created_at)\n  SELECT key_hash, operator_id, created_at FROM operator_creation_receipts\n  WHERE booking_id = OLD.id;\nEND","table":"bookings","type":"trigger"},{"name":"operator_creation_receipts_booking_idx","sql":"CREATE INDEX operator_creation_receipts_booking_idx ON operator_creation_receipts(booking_id)","table":"operator_creation_receipts","type":"index"},{"name":"operator_mail_invocations_key","sql":"CREATE INDEX operator_mail_invocations_key ON operator_mail_invocations(provider_key, state)","table":"operator_mail_invocations","type":"index"},{"name":"operator_notification_admission","sql":"CREATE TRIGGER operator_notification_admission AFTER INSERT ON delivery_outbox\nWHEN NEW.kind IN ('mail_send', 'reminder')\n  AND (json_extract(NEW.payload_json, '$.recipientRole') = 'operator' OR\n    (json_extract(NEW.payload_json, '$.recipientRole') IS NULL AND\n      ((substr(COALESCE(json_extract(NEW.payload_json, '$.providerIdempotencyKey'), NEW.idempotency_key), 1, 11) = 'connection:'\n          AND instr(COALESCE(json_extract(NEW.payload_json, '$.providerIdempotencyKey'), NEW.idempotency_key), ':operator:') > 11)\n        OR (substr(COALESCE(json_extract(NEW.payload_json, '$.providerIdempotencyKey'), NEW.idempotency_key), 1, length('request:' || NEW.request_id || ':operator:')) = 'request:' || NEW.request_id || ':operator:'\n          AND substr(COALESCE(json_extract(NEW.payload_json, '$.providerIdempotencyKey'), NEW.idempotency_key), -10) = ':submitted'))))\n  AND NOT EXISTS (SELECT 1 FROM operators o WHERE o.removed_at IS NULL\n    AND o.normalized_email = lower(trim(COALESCE(json_extract(NEW.payload_json, '$.wireMail.to'), json_extract(NEW.payload_json, '$.to'))))\n    AND ((json_type(NEW.payload_json, '$.operatorAccess') IS NULL AND o.access_generation = 0)\n      OR (o.id = json_extract(NEW.payload_json, '$.operatorAccess.id')\n        AND o.access_generation = json_extract(NEW.payload_json, '$.operatorAccess.generation'))))\nBEGIN\n  UPDATE delivery_outbox\n    SET payload_json = json_set(payload_json, '$.operatorAccessRevoked', json('true')),\n      state = CASE WHEN state IN ('pending', 'processing') THEN 'failed' ELSE state END,\n      last_error_code = CASE WHEN state IN ('pending', 'processing') THEN 'operator_removed' ELSE last_error_code END\n    WHERE id = NEW.id;\nEND","table":"delivery_outbox","type":"trigger"},{"name":"operator_notification_generation","sql":"CREATE TRIGGER operator_notification_generation AFTER UPDATE OF removed_at ON operators\nWHEN NEW.removed_at IS NOT NULL AND OLD.removed_at IS NULL\nBEGIN\n  UPDATE operators SET access_generation = OLD.access_generation + 1 WHERE id = NEW.id;\nEND","table":"operators","type":"trigger"},{"name":"operator_sessions_active_idx","sql":"CREATE INDEX operator_sessions_active_idx ON operator_sessions(token_hash, expires_at, revoked_at)","table":"operator_sessions","type":"index"},{"name":"profile_focus_areas_position_idx","sql":"CREATE UNIQUE INDEX profile_focus_areas_position_idx ON profile_focus_areas(profile_id, position)","table":"profile_focus_areas","type":"index"},{"name":"provider_webhook_delivery","sql":"CREATE INDEX provider_webhook_delivery ON provider_webhook_events(delivery_id)","table":"provider_webhook_events","type":"index"},{"name":"public_rate_booking_time","sql":"CREATE INDEX public_rate_booking_time ON public_rate_events(client_key, admitted_at) WHERE booking_mutation = 1","table":"public_rate_events","type":"index"},{"name":"public_rate_client_time","sql":"CREATE INDEX public_rate_client_time ON public_rate_events(client_key, admitted_at)","table":"public_rate_events","type":"index"},{"name":"public_rate_expiry","sql":"CREATE INDEX public_rate_expiry ON public_rate_events(expires_at)","table":"public_rate_events","type":"index"},{"name":"public_rate_provider_time","sql":"CREATE INDEX public_rate_provider_time ON public_rate_events(provider, admitted_at) WHERE provider IS NOT NULL","table":"public_rate_events","type":"index"},{"name":"public_rate_request_time","sql":"CREATE INDEX public_rate_request_time ON public_rate_events(client_key, admitted_at) WHERE alternative_submission = 1","table":"public_rate_events","type":"index"},{"name":"recurring_availability_event_type_idx","sql":"CREATE INDEX recurring_availability_event_type_idx ON recurring_availability_windows(event_type_id, weekday)","table":"recurring_availability_windows","type":"index"},{"name":"request_only_booking_insert","sql":"CREATE TRIGGER request_only_booking_insert BEFORE INSERT ON bookings\nWHEN EXISTS(SELECT 1 FROM event_types WHERE id=NEW.event_type_id AND request_only=1)\nBEGIN SELECT RAISE(ABORT,'request_only_event'); END","table":"bookings","type":"trigger"},{"name":"request_only_occurrence_insert","sql":"CREATE TRIGGER request_only_occurrence_insert BEFORE INSERT ON booking_occurrences\nWHEN NEW.state='current' AND EXISTS(SELECT 1 FROM bookings b JOIN event_types e ON e.id=b.event_type_id WHERE b.id=NEW.booking_id AND e.request_only=1)\nBEGIN SELECT RAISE(ABORT,'request_only_event'); END","table":"booking_occurrences","type":"trigger"},{"name":"request_review_erasure_email","sql":"CREATE INDEX request_review_erasure_email ON availability_request_review_nonces(invitee_email)","table":"availability_request_review_nonces","type":"index"},{"name":"rer_erasure_active_subject","sql":"CREATE UNIQUE INDEX rer_erasure_active_subject ON rer_erasure_operations(entity,subject) WHERE subject IS NOT NULL","table":"rer_erasure_operations","type":"index"},{"name":"rer_erasure_rates_subject","sql":"CREATE INDEX rer_erasure_rates_subject ON rer_erasure_rates(entity, subject)","table":"rer_erasure_rates","type":"index"},{"name":"rer_mail_development_outbox_order","sql":"CREATE INDEX rer_mail_development_outbox_order\n  ON rer_mail_development_outbox(created_at DESC, sequence DESC)","table":"rer_mail_development_outbox","type":"index"},{"name":"retain_deleted_event_correspondence","sql":"CREATE TRIGGER retain_deleted_event_correspondence BEFORE DELETE ON event_types BEGIN\n  INSERT INTO booking_correspondence (booking_id,templates_json,created_at,updated_at)\n  SELECT b.id,c.templates_json,c.created_at,c.updated_at FROM bookings b\n    JOIN event_correspondence c ON c.event_type_id=b.event_type_id\n    WHERE b.event_type_id=OLD.id\n  ON CONFLICT(booking_id) DO UPDATE SET templates_json=excluded.templates_json,updated_at=excluded.updated_at;\nEND","table":"event_types","type":"trigger"},{"name":"social_proof_entries_position_idx","sql":"CREATE UNIQUE INDEX social_proof_entries_position_idx ON social_proof_entries(profile_id, position)","table":"social_proof_entries","type":"index"}],"sourceIdentity":"8b88f44340c61c9b93eaac562206385d","tables":[{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"entity_kind","notnull":1,"pk":0,"type":"TEXT"},{"name":"action","notnull":1,"pk":0,"type":"TEXT"},{"name":"actor_type","notnull":1,"pk":0,"type":"TEXT"},{"name":"actor_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"happened_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"erased_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"anonymized_audit","rowidAlias":null,"sql":"CREATE TABLE anonymized_audit (\n id TEXT PRIMARY KEY NOT NULL,\n entity_kind TEXT NOT NULL,\n action TEXT NOT NULL,\n actor_type TEXT NOT NULL,\n actor_id TEXT,\n happened_at TEXT NOT NULL,\n erased_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"override_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"position","notnull":1,"pk":0,"type":"INTEGER"},{"name":"start_minute","notnull":1,"pk":0,"type":"INTEGER"},{"name":"end_minute","notnull":1,"pk":0,"type":"INTEGER"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["availability_date_overrides"],"name":"availability_date_override_windows","rowidAlias":null,"sql":"CREATE TABLE availability_date_override_windows (\n  id TEXT PRIMARY KEY NOT NULL,\n  override_id TEXT NOT NULL REFERENCES availability_date_overrides(id) ON DELETE CASCADE,\n  position INTEGER NOT NULL,\n  start_minute INTEGER NOT NULL CHECK (start_minute BETWEEN 0 AND 1439),\n  end_minute INTEGER NOT NULL CHECK (end_minute BETWEEN 1 AND 1440),\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL,\n  CHECK (start_minute < end_minute),\n  UNIQUE(override_id, position)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"event_type_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"host_date","notnull":1,"pk":0,"type":"TEXT"},{"name":"mode","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["event_types"],"name":"availability_date_overrides","rowidAlias":null,"sql":"CREATE TABLE availability_date_overrides (\n  id TEXT PRIMARY KEY NOT NULL,\n  event_type_id TEXT NOT NULL REFERENCES event_types(id) ON DELETE CASCADE,\n  host_date TEXT NOT NULL CHECK (\n    length(host_date) = 10\n    AND host_date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'\n  ),\n  mode TEXT NOT NULL CHECK (mode IN ('open', 'closed')),\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL,\n  UNIQUE(event_type_id, host_date)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"request_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"requested_date","notnull":1,"pk":0,"type":"TEXT"},{"name":"start_minute","notnull":1,"pk":0,"type":"INTEGER"},{"name":"end_minute","notnull":1,"pk":0,"type":"INTEGER"},{"name":"position","notnull":1,"pk":0,"type":"INTEGER"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["availability_requests"],"name":"availability_request_windows","rowidAlias":null,"sql":"CREATE TABLE availability_request_windows (\n  id TEXT PRIMARY KEY NOT NULL,\n  request_id TEXT NOT NULL REFERENCES availability_requests(id) ON DELETE CASCADE,\n  requested_date TEXT NOT NULL CHECK (\n    length(requested_date) = 10\n    AND requested_date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'\n  ),\n  start_minute INTEGER NOT NULL CHECK (start_minute BETWEEN 0 AND 1439),\n  end_minute INTEGER NOT NULL CHECK (end_minute BETWEEN 1 AND 1440),\n  position INTEGER NOT NULL,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL,\n  CHECK (start_minute < end_minute),\n  UNIQUE(request_id, position)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"event_type_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"event_title","notnull":1,"pk":0,"type":"TEXT"},{"name":"invitee_name","notnull":1,"pk":0,"type":"TEXT"},{"name":"invitee_email","notnull":1,"pk":0,"type":"TEXT"},{"name":"invitee_timezone","notnull":1,"pk":0,"type":"TEXT"},{"name":"note","notnull":0,"pk":0,"type":"TEXT"},{"name":"state","notnull":1,"pk":0,"type":"TEXT"},{"name":"nonce_hash","notnull":1,"pk":0,"type":"TEXT"},{"name":"composition_hash","notnull":1,"pk":0,"type":"TEXT"},{"name":"booking_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"submitted_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"handled_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"closed_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"state_changed_by_operator_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["event_types","operators"],"name":"availability_requests","rowidAlias":null,"sql":"CREATE TABLE availability_requests (\n  id TEXT PRIMARY KEY NOT NULL,\n  event_type_id TEXT NOT NULL REFERENCES event_types(id) ON DELETE RESTRICT,\n  event_title TEXT NOT NULL,\n  invitee_name TEXT NOT NULL,\n  invitee_email TEXT NOT NULL,\n  invitee_timezone TEXT NOT NULL,\n  note TEXT,\n  state TEXT NOT NULL CHECK (state IN ('submitted', 'handled', 'closed')),\n  nonce_hash TEXT NOT NULL UNIQUE,\n  composition_hash TEXT NOT NULL,\n  booking_id TEXT,\n  submitted_at TEXT NOT NULL,\n  handled_at TEXT,\n  closed_at TEXT,\n  state_changed_by_operator_id TEXT REFERENCES operators(id) ON DELETE SET NULL,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":0,"pk":1,"type":"TEXT"},{"name":"name","notnull":1,"pk":0,"type":"TEXT"},{"name":"windows_json","notnull":1,"pk":0,"type":"TEXT"},{"name":"block_us_holidays","notnull":1,"pk":0,"type":"INTEGER"},{"name":"reopened_holidays_json","notnull":1,"pk":0,"type":"TEXT"},{"name":"time_off_json","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"availability_schedules","rowidAlias":null,"sql":"CREATE TABLE availability_schedules (\n  id TEXT PRIMARY KEY,\n  name TEXT NOT NULL,\n  windows_json TEXT NOT NULL CHECK (json_valid(windows_json)),\n  block_us_holidays INTEGER NOT NULL DEFAULT 0 CHECK (block_us_holidays IN (0,1)),\n  reopened_holidays_json TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(reopened_holidays_json)),\n  time_off_json TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(time_off_json)),\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":0,"pk":1,"type":"TEXT"},{"name":"object_key","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"avatar_object_deletions","rowidAlias":null,"sql":"CREATE TABLE avatar_object_deletions (\n  id TEXT PRIMARY KEY,\n  object_key TEXT NOT NULL UNIQUE,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"delivery_id","notnull":0,"pk":1,"type":"TEXT"},{"name":"payload_hash","notnull":1,"pk":0,"type":"TEXT"},{"name":"state","notnull":1,"pk":0,"type":"TEXT"},{"name":"provider_message_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"base_mail_dispatch","rowidAlias":null,"sql":"CREATE TABLE base_mail_dispatch (\n delivery_id TEXT PRIMARY KEY,\n payload_hash TEXT NOT NULL,\n state TEXT NOT NULL CHECK(state IN ('invoking','accepted','uncertain','rejected','rate_limited')),\n provider_message_id TEXT,\n updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"kind","notnull":1,"pk":0,"type":"TEXT"},{"name":"value","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_by_operator_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["operators"],"name":"blocked_address_rules","rowidAlias":null,"sql":"CREATE TABLE blocked_address_rules (\n  id TEXT PRIMARY KEY NOT NULL,\n  kind TEXT NOT NULL CHECK (kind IN ('email', 'domain')),\n  value TEXT NOT NULL,\n  created_by_operator_id TEXT NOT NULL REFERENCES operators(id),\n  created_at TEXT NOT NULL,\n  UNIQUE(kind, value)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"booking_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"question_key","notnull":1,"pk":0,"type":"TEXT"},{"name":"question_label","notnull":1,"pk":0,"type":"TEXT"},{"name":"question_kind","notnull":1,"pk":0,"type":"TEXT"},{"name":"value_json","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["bookings"],"name":"booking_answers","rowidAlias":null,"sql":"CREATE TABLE booking_answers (\n  id TEXT PRIMARY KEY NOT NULL,\n  booking_id TEXT NOT NULL REFERENCES bookings(id) ON DELETE CASCADE,\n  question_key TEXT NOT NULL,\n  question_label TEXT NOT NULL,\n  question_kind TEXT NOT NULL,\n  value_json TEXT NOT NULL,\n  created_at TEXT NOT NULL,\n  UNIQUE(booking_id, question_key)\n)"},{"columns":[{"name":"booking_id","notnull":1,"pk":1,"type":"TEXT"},{"name":"status","notnull":1,"pk":0,"type":"TEXT"},{"name":"note","notnull":1,"pk":0,"type":"TEXT"},{"name":"marked_by_operator_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"marked_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["bookings","operators"],"name":"booking_attendance","rowidAlias":null,"sql":"CREATE TABLE booking_attendance (\n  booking_id TEXT PRIMARY KEY NOT NULL REFERENCES bookings(id) ON DELETE CASCADE,\n  status TEXT NOT NULL CHECK (status IN ('attended', 'no_show')),\n  note TEXT NOT NULL,\n  marked_by_operator_id TEXT NOT NULL REFERENCES operators(id),\n  marked_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"booking_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"occurrence_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"provider_event_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"provider_updated_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"canonical_start_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"canonical_end_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"canonical_location","notnull":1,"pk":0,"type":"TEXT"},{"name":"external_start_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"external_end_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"external_location","notnull":0,"pk":0,"type":"TEXT"},{"name":"state","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["booking_occurrences","bookings"],"name":"booking_calendar_conflicts","rowidAlias":null,"sql":"CREATE TABLE booking_calendar_conflicts (\n  id TEXT PRIMARY KEY NOT NULL,\n  booking_id TEXT NOT NULL REFERENCES bookings(id) ON DELETE CASCADE,\n  occurrence_id TEXT NOT NULL REFERENCES booking_occurrences(id) ON DELETE CASCADE,\n  provider_event_id TEXT NOT NULL,\n  provider_updated_at TEXT NOT NULL,\n  canonical_start_at TEXT NOT NULL,\n  canonical_end_at TEXT NOT NULL,\n  canonical_location TEXT NOT NULL,\n  external_start_at TEXT,\n  external_end_at TEXT,\n  external_location TEXT,\n  state TEXT NOT NULL CHECK (state IN ('open', 'restored', 'cancelled')),\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL,\n  UNIQUE(booking_id, occurrence_id, provider_event_id, provider_updated_at)\n)"},{"columns":[{"name":"booking_id","notnull":0,"pk":1,"type":"TEXT"},{"name":"templates_json","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["bookings"],"name":"booking_correspondence","rowidAlias":null,"sql":"CREATE TABLE booking_correspondence (\n  booking_id TEXT PRIMARY KEY REFERENCES bookings(id) ON DELETE CASCADE,\n  templates_json TEXT NOT NULL,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"booking_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"occurrence_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"action","notnull":1,"pk":0,"type":"TEXT"},{"name":"actor_type","notnull":1,"pk":0,"type":"TEXT"},{"name":"actor_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"previous_start_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"new_start_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"reason","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["booking_occurrences","bookings"],"name":"booking_history","rowidAlias":null,"sql":"CREATE TABLE booking_history (\n  id TEXT PRIMARY KEY NOT NULL,\n  booking_id TEXT NOT NULL REFERENCES bookings(id) ON DELETE CASCADE,\n  occurrence_id TEXT REFERENCES booking_occurrences(id) ON DELETE SET NULL,\n  action TEXT NOT NULL CHECK (action IN ('created', 'rescheduled', 'cancelled', 'attendance_marked', 'calendar_cancelled')),\n  actor_type TEXT NOT NULL CHECK (actor_type IN ('invitee', 'operator', 'calendar_provider', 'system')),\n  actor_id TEXT,\n  previous_start_at TEXT,\n  new_start_at TEXT,\n  reason TEXT,\n  created_at TEXT NOT NULL\n)"},{"columns":[{"name":"scope","notnull":0,"pk":1,"type":"TEXT"},{"name":"limits_json","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"booking_limit_policies","rowidAlias":null,"sql":"CREATE TABLE booking_limit_policies (\n  scope TEXT PRIMARY KEY,\n  limits_json TEXT NOT NULL CHECK (json_valid(limits_json)),\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"event_type_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"kind","notnull":1,"pk":0,"type":"TEXT"},{"name":"overrides_json","notnull":0,"pk":0,"type":"TEXT"},{"name":"expires_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"consumed_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"consumed_booking_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"revoked_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["bookings","event_types"],"name":"booking_links","rowidAlias":null,"sql":"CREATE TABLE booking_links (\n  id TEXT PRIMARY KEY NOT NULL,\n  event_type_id TEXT NOT NULL REFERENCES event_types(id) ON DELETE CASCADE,\n  kind TEXT NOT NULL CHECK(kind IN ('single_use','one_off')),\n  overrides_json TEXT,\n  expires_at TEXT NOT NULL,\n  consumed_at TEXT,\n  consumed_booking_id TEXT REFERENCES bookings(id),\n  revoked_at TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"booking_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"sequence","notnull":1,"pk":0,"type":"INTEGER"},{"name":"start_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"end_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"occupied_start_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"occupied_end_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"host_date","notnull":1,"pk":0,"type":"TEXT"},{"name":"state","notnull":1,"pk":0,"type":"TEXT"},{"name":"is_current","notnull":1,"pk":0,"type":"INTEGER"},{"name":"replaced_by_occurrence_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"closed_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"blocks_time","notnull":1,"pk":0,"type":"INTEGER"}],"count":1,"dependencies":["bookings"],"name":"booking_occurrences","rowidAlias":null,"sql":"CREATE TABLE booking_occurrences (\n  id TEXT PRIMARY KEY NOT NULL,\n  booking_id TEXT NOT NULL REFERENCES bookings(id) ON DELETE CASCADE,\n  sequence INTEGER NOT NULL CHECK (sequence >= 0),\n  start_at TEXT NOT NULL,\n  end_at TEXT NOT NULL,\n  occupied_start_at TEXT NOT NULL,\n  occupied_end_at TEXT NOT NULL,\n  host_date TEXT NOT NULL,\n  state TEXT NOT NULL CHECK (state IN ('current', 'rescheduled', 'cancelled')),\n  is_current INTEGER NOT NULL CHECK (is_current IN (0, 1)),\n  replaced_by_occurrence_id TEXT,\n  created_at TEXT NOT NULL,\n  closed_at TEXT, blocks_time INTEGER NOT NULL DEFAULT 1 CHECK (blocks_time IN (0,1)),\n  CHECK (start_at < end_at),\n  CHECK (occupied_start_at < occupied_end_at),\n  UNIQUE(booking_id, sequence)\n)"},{"columns":[{"name":"booking_id","notnull":0,"pk":1,"type":"TEXT"},{"name":"locked_timezone","notnull":1,"pk":0,"type":"TEXT"},{"name":"browser_timezone","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["bookings"],"name":"booking_presentation","rowidAlias":null,"sql":"CREATE TABLE booking_presentation (\n  booking_id TEXT PRIMARY KEY REFERENCES bookings(id) ON DELETE CASCADE,\n  locked_timezone TEXT NOT NULL,\n  browser_timezone TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"booking_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"occurrence_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"action","notnull":1,"pk":0,"type":"TEXT"},{"name":"actor_type","notnull":1,"pk":0,"type":"TEXT"},{"name":"actor_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"reason","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["booking_occurrences","bookings"],"name":"booking_request_history","rowidAlias":null,"sql":"CREATE TABLE booking_request_history (\n id TEXT PRIMARY KEY NOT NULL,\n booking_id TEXT NOT NULL REFERENCES bookings(id) ON DELETE CASCADE,\n occurrence_id TEXT REFERENCES booking_occurrences(id) ON DELETE SET NULL,\n action TEXT NOT NULL CHECK(action IN ('reschedule_requested','reschedule_request_reminded','reschedule_request_picked','reschedule_request_expired')),\n actor_type TEXT NOT NULL CHECK(actor_type IN ('operator','system','invitee')),\n actor_id TEXT,\n reason TEXT,\n created_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"booking_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"occurrence_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"state","notnull":1,"pk":0,"type":"TEXT"},{"name":"message","notnull":1,"pk":0,"type":"TEXT"},{"name":"release_time","notnull":1,"pk":0,"type":"INTEGER"},{"name":"actor_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"archive_historical","notnull":1,"pk":0,"type":"INTEGER"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"expires_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"reminder_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"reminded_at","notnull":0,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["booking_occurrences","bookings"],"name":"booking_reschedule_requests","rowidAlias":null,"sql":"CREATE TABLE booking_reschedule_requests (\n id TEXT PRIMARY KEY NOT NULL,\n booking_id TEXT NOT NULL REFERENCES bookings(id) ON DELETE CASCADE,\n occurrence_id TEXT NOT NULL REFERENCES booking_occurrences(id) ON DELETE CASCADE,\n state TEXT NOT NULL CHECK (state IN ('open','picked','expired','cancelled')),\n message TEXT NOT NULL CHECK (length(message)<=1000),\n release_time INTEGER NOT NULL CHECK (release_time IN (0,1)),\n actor_id TEXT NOT NULL,\n archive_historical INTEGER NOT NULL DEFAULT 0 CHECK(archive_historical IN (0,1)),\n created_at TEXT NOT NULL,\n updated_at TEXT NOT NULL,\n expires_at TEXT NOT NULL,\n reminder_at TEXT,\n reminded_at TEXT\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"event_type_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"event_slug","notnull":1,"pk":0,"type":"TEXT"},{"name":"event_title","notnull":1,"pk":0,"type":"TEXT"},{"name":"duration_minutes","notnull":1,"pk":0,"type":"INTEGER"},{"name":"location_type","notnull":1,"pk":0,"type":"TEXT"},{"name":"location_label","notnull":1,"pk":0,"type":"TEXT"},{"name":"location_value","notnull":1,"pk":0,"type":"TEXT"},{"name":"invitee_name","notnull":1,"pk":0,"type":"TEXT"},{"name":"invitee_email","notnull":1,"pk":0,"type":"TEXT"},{"name":"host_timezone","notnull":1,"pk":0,"type":"TEXT"},{"name":"invitee_timezone","notnull":1,"pk":0,"type":"TEXT"},{"name":"state","notnull":1,"pk":0,"type":"TEXT"},{"name":"ical_uid","notnull":1,"pk":0,"type":"TEXT"},{"name":"calendar_state","notnull":1,"pk":0,"type":"TEXT"},{"name":"meeting_state","notnull":1,"pk":0,"type":"TEXT"},{"name":"meeting_url","notnull":0,"pk":0,"type":"TEXT"},{"name":"current_occurrence_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"cancelled_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"cancelled_reason","notnull":0,"pk":0,"type":"TEXT"},{"name":"calendar_provider_event_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"calendar_provider_updated_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"imported","notnull":1,"pk":0,"type":"INTEGER"},{"name":"invitee_name_folded","notnull":1,"pk":0,"type":"TEXT"},{"name":"invitee_email_folded","notnull":1,"pk":0,"type":"TEXT"},{"name":"calendar_required","notnull":1,"pk":0,"type":"INTEGER"},{"name":"attribution_json","notnull":1,"pk":0,"type":"TEXT"},{"name":"post_booking_redirect_url","notnull":0,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"bookings","rowidAlias":null,"sql":"CREATE TABLE bookings (\n  id TEXT PRIMARY KEY NOT NULL,\n  event_type_id TEXT,\n  event_slug TEXT NOT NULL,\n  event_title TEXT NOT NULL,\n  duration_minutes INTEGER NOT NULL CHECK (duration_minutes BETWEEN 5 AND 480),\n  location_type TEXT NOT NULL,\n  location_label TEXT NOT NULL,\n  location_value TEXT NOT NULL,\n  invitee_name TEXT NOT NULL,\n  invitee_email TEXT NOT NULL,\n  host_timezone TEXT NOT NULL,\n  invitee_timezone TEXT NOT NULL,\n  state TEXT NOT NULL CHECK (state IN ('confirmed', 'cancelled', 'rescheduled')),\n  ical_uid TEXT NOT NULL UNIQUE,\n  calendar_state TEXT NOT NULL CHECK (calendar_state IN ('pending', 'succeeded', 'failed')),\n  meeting_state TEXT NOT NULL CHECK (meeting_state IN ('pending', 'succeeded', 'failed', 'not_required')),\n  meeting_url TEXT,\n  current_occurrence_id TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL,\n  cancelled_at TEXT,\n  cancelled_reason TEXT\n, calendar_provider_event_id TEXT, calendar_provider_updated_at TEXT, imported INTEGER NOT NULL DEFAULT 0 CHECK(imported IN(0,1)), invitee_name_folded TEXT NOT NULL DEFAULT '', invitee_email_folded TEXT NOT NULL DEFAULT '', calendar_required INTEGER NOT NULL DEFAULT 1 CHECK (calendar_required IN (0, 1)), attribution_json TEXT NOT NULL DEFAULT '{}'\n  CHECK (json_valid(attribution_json) AND json_type(attribution_json) = 'object'), post_booking_redirect_url TEXT DEFAULT NULL)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"calendar_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"starts_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"ends_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"transparency","notnull":1,"pk":0,"type":"TEXT"},{"name":"deleted","notnull":1,"pk":0,"type":"INTEGER"},{"name":"observed_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"calendar_busy_intervals","rowidAlias":null,"sql":"CREATE TABLE calendar_busy_intervals (\n  id TEXT PRIMARY KEY NOT NULL,\n  calendar_id TEXT NOT NULL,\n  starts_at TEXT NOT NULL,\n  ends_at TEXT NOT NULL,\n  transparency TEXT NOT NULL DEFAULT 'opaque' CHECK (transparency IN ('opaque', 'transparent')),\n  deleted INTEGER NOT NULL DEFAULT 0 CHECK (deleted IN (0, 1)),\n  observed_at TEXT NOT NULL,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL,\n  UNIQUE(calendar_id, starts_at, ends_at)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"calendar_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"starts_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"ends_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"observed_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"calendar_busy_read_windows","rowidAlias":null,"sql":"CREATE TABLE calendar_busy_read_windows (\n  id TEXT PRIMARY KEY NOT NULL,\n  calendar_id TEXT NOT NULL,\n  starts_at TEXT NOT NULL,\n  ends_at TEXT NOT NULL,\n  observed_at TEXT NOT NULL,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"calendar_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"purpose","notnull":1,"pk":0,"type":"TEXT"},{"name":"conference_capable","notnull":1,"pk":0,"type":"INTEGER"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"calendar_connection_calendars","rowidAlias":null,"sql":"CREATE TABLE calendar_connection_calendars (\n  id TEXT PRIMARY KEY NOT NULL,\n  calendar_id TEXT NOT NULL,\n  purpose TEXT NOT NULL CHECK (purpose IN ('destination', 'conflict')),\n  conference_capable INTEGER NOT NULL DEFAULT 0 CHECK (conference_capable IN (0, 1)),\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL,\n  UNIQUE(calendar_id, purpose)\n)"},{"columns":[{"name":"singleton_key","notnull":1,"pk":1,"type":"TEXT"},{"name":"provider","notnull":1,"pk":0,"type":"TEXT"},{"name":"status","notnull":1,"pk":0,"type":"TEXT"},{"name":"authorised_by_operator_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"account_email","notnull":0,"pk":0,"type":"TEXT"},{"name":"access_token_ciphertext","notnull":0,"pk":0,"type":"TEXT"},{"name":"refresh_token_ciphertext","notnull":0,"pk":0,"type":"TEXT"},{"name":"access_token_expires_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"sync_cursor","notnull":0,"pk":0,"type":"TEXT"},{"name":"channel_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"channel_resource_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"channel_expires_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"last_checked_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"last_successful_read_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"unhealthy_code","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"calendar_connections","rowidAlias":null,"sql":"CREATE TABLE calendar_connections (\n  singleton_key TEXT PRIMARY KEY NOT NULL CHECK (singleton_key = 'default'),\n  provider TEXT NOT NULL CHECK (provider = 'google'),\n  status TEXT NOT NULL CHECK (status IN ('disconnected', 'healthy', 'unhealthy')),\n  authorised_by_operator_id TEXT,\n  account_email TEXT,\n  access_token_ciphertext TEXT,\n  refresh_token_ciphertext TEXT,\n  access_token_expires_at TEXT,\n  sync_cursor TEXT,\n  channel_id TEXT,\n  channel_resource_id TEXT,\n  channel_expires_at TEXT,\n  last_checked_at TEXT,\n  last_successful_read_at TEXT,\n  unhealthy_code TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"booking_id","notnull":1,"pk":1,"type":"TEXT"},{"name":"provider_event_id","notnull":1,"pk":2,"type":"TEXT"},{"name":"occurrence_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"state","notnull":1,"pk":0,"type":"TEXT"},{"name":"attempts","notnull":1,"pk":0,"type":"INTEGER"},{"name":"next_attempt_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"last_error_code","notnull":0,"pk":0,"type":"TEXT"},{"name":"resolution","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"archive_historical","notnull":1,"pk":0,"type":"INTEGER"}],"count":1,"dependencies":["bookings"],"name":"calendar_deletion_probes","rowidAlias":null,"sql":"CREATE TABLE calendar_deletion_probes (\n  booking_id TEXT NOT NULL REFERENCES bookings(id) ON DELETE CASCADE,\n  provider_event_id TEXT NOT NULL,\n  occurrence_id TEXT NOT NULL,\n  state TEXT NOT NULL CHECK (state IN ('pending', 'processing', 'resolved', 'failed')),\n  attempts INTEGER NOT NULL DEFAULT 0,\n  next_attempt_at TEXT NOT NULL,\n  last_error_code TEXT,\n  resolution TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL, archive_historical INTEGER NOT NULL DEFAULT 0 CHECK (archive_historical IN (0, 1)),\n  PRIMARY KEY (booking_id, provider_event_id)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"outbox_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"attempt_number","notnull":1,"pk":0,"type":"INTEGER"},{"name":"outcome","notnull":1,"pk":0,"type":"TEXT"},{"name":"provider_message_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"error_code","notnull":0,"pk":0,"type":"TEXT"},{"name":"attempted_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["delivery_outbox"],"name":"delivery_attempts","rowidAlias":null,"sql":"CREATE TABLE delivery_attempts (\n  id TEXT PRIMARY KEY NOT NULL,\n  outbox_id TEXT NOT NULL REFERENCES delivery_outbox(id) ON DELETE CASCADE,\n  attempt_number INTEGER NOT NULL CHECK (attempt_number > 0),\n  outcome TEXT NOT NULL CHECK (outcome IN ('succeeded', 'retrying', 'failed')),\n  provider_message_id TEXT,\n  error_code TEXT,\n  attempted_at TEXT NOT NULL,\n  UNIQUE(outbox_id, attempt_number)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"kind","notnull":1,"pk":0,"type":"TEXT"},{"name":"idempotency_key","notnull":1,"pk":0,"type":"TEXT"},{"name":"booking_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"occurrence_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"request_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"payload_json","notnull":1,"pk":0,"type":"TEXT"},{"name":"state","notnull":1,"pk":0,"type":"TEXT"},{"name":"attempts","notnull":1,"pk":0,"type":"INTEGER"},{"name":"next_attempt_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"last_error_code","notnull":0,"pk":0,"type":"TEXT"},{"name":"succeeded_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"delivery_outbox","rowidAlias":null,"sql":"CREATE TABLE delivery_outbox (\n  id TEXT PRIMARY KEY NOT NULL,\n  kind TEXT NOT NULL CHECK (kind IN ('calendar_upsert', 'calendar_cancel', 'mail_send', 'reminder')),\n  idempotency_key TEXT NOT NULL UNIQUE,\n  booking_id TEXT,\n  occurrence_id TEXT,\n  request_id TEXT,\n  payload_json TEXT NOT NULL,\n  state TEXT NOT NULL CHECK (state IN ('pending', 'processing', 'succeeded', 'failed')),\n  attempts INTEGER NOT NULL DEFAULT 0 CHECK (attempts >= 0),\n  next_attempt_at TEXT NOT NULL,\n  last_error_code TEXT,\n  succeeded_at TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"origin","notnull":1,"pk":1,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"embed_allowed_origins","rowidAlias":null,"sql":"CREATE TABLE embed_allowed_origins (\n  origin TEXT PRIMARY KEY NOT NULL,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"booking_id","notnull":1,"pk":1,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"completed_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"last_error_code","notnull":0,"pk":0,"type":"TEXT"},{"name":"archive_historical","notnull":1,"pk":0,"type":"INTEGER"},{"name":"receipt_id","notnull":0,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["person_erasure_receipts"],"name":"erased_calendar_targets","rowidAlias":null,"sql":"CREATE TABLE erased_calendar_targets (\n booking_id TEXT PRIMARY KEY NOT NULL,\n created_at TEXT NOT NULL,\n completed_at TEXT,\n last_error_code TEXT\n, archive_historical INTEGER NOT NULL DEFAULT 0 CHECK (archive_historical IN (0, 1)), receipt_id TEXT REFERENCES person_erasure_receipts(id))"},{"columns":[{"name":"event_type_id","notnull":0,"pk":1,"type":"TEXT"},{"name":"locked_timezone","notnull":0,"pk":0,"type":"TEXT"},{"name":"reschedule_cutoff_minutes","notnull":0,"pk":0,"type":"INTEGER"},{"name":"cancellation_cutoff_minutes","notnull":0,"pk":0,"type":"INTEGER"},{"name":"reschedule_cap","notnull":0,"pk":0,"type":"INTEGER"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["event_types"],"name":"event_booking_policies","rowidAlias":null,"sql":"CREATE TABLE event_booking_policies (\n  event_type_id TEXT PRIMARY KEY REFERENCES event_types(id) ON DELETE CASCADE,\n  locked_timezone TEXT,\n  reschedule_cutoff_minutes INTEGER CHECK(reschedule_cutoff_minutes IS NULL OR reschedule_cutoff_minutes BETWEEN 0 AND 2147483647),\n  cancellation_cutoff_minutes INTEGER CHECK(cancellation_cutoff_minutes IS NULL OR cancellation_cutoff_minutes BETWEEN 0 AND 2147483647),\n  reschedule_cap INTEGER CHECK(reschedule_cap IS NULL OR reschedule_cap BETWEEN 0 AND 2147483647),\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"event_type_id","notnull":0,"pk":1,"type":"TEXT"},{"name":"templates_json","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["event_types"],"name":"event_correspondence","rowidAlias":null,"sql":"CREATE TABLE event_correspondence (\n  event_type_id TEXT PRIMARY KEY REFERENCES event_types(id) ON DELETE CASCADE,\n  templates_json TEXT NOT NULL,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"event_type_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"position","notnull":1,"pk":0,"type":"INTEGER"},{"name":"kind","notnull":1,"pk":0,"type":"TEXT"},{"name":"label","notnull":1,"pk":0,"type":"TEXT"},{"name":"required","notnull":1,"pk":0,"type":"INTEGER"},{"name":"options_json","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"public_key","notnull":0,"pk":0,"type":"TEXT"},{"name":"private","notnull":1,"pk":0,"type":"INTEGER"}],"count":1,"dependencies":["event_types"],"name":"event_questions","rowidAlias":null,"sql":"CREATE TABLE \"event_questions\" (\n  id TEXT PRIMARY KEY NOT NULL,\n  event_type_id TEXT NOT NULL REFERENCES event_types(id) ON DELETE CASCADE,\n  position INTEGER NOT NULL,\n  kind TEXT NOT NULL CHECK (kind IN ('text', 'textarea', 'phone', 'single_choice', 'dropdown', 'multiple_choice', 'checkbox')),\n  label TEXT NOT NULL,\n  required INTEGER NOT NULL DEFAULT 0 CHECK (required IN (0, 1)),\n  options_json TEXT NOT NULL,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL,\n  public_key TEXT\n, private INTEGER NOT NULL DEFAULT 0 CHECK (private IN (0, 1)))"},{"columns":[{"name":"event_type_id","notnull":0,"pk":1,"type":"TEXT"},{"name":"schedule_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["availability_schedules","event_types"],"name":"event_schedule_bindings","rowidAlias":null,"sql":"CREATE TABLE event_schedule_bindings (\n  event_type_id TEXT PRIMARY KEY REFERENCES event_types(id) ON DELETE CASCADE,\n  schedule_id TEXT NOT NULL REFERENCES availability_schedules(id),\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"status","notnull":1,"pk":0,"type":"TEXT"},{"name":"slug","notnull":1,"pk":0,"type":"TEXT"},{"name":"title","notnull":1,"pk":0,"type":"TEXT"},{"name":"description","notnull":1,"pk":0,"type":"TEXT"},{"name":"duration_minutes","notnull":1,"pk":0,"type":"INTEGER"},{"name":"color","notnull":1,"pk":0,"type":"TEXT"},{"name":"location_type","notnull":1,"pk":0,"type":"TEXT"},{"name":"location_label","notnull":1,"pk":0,"type":"TEXT"},{"name":"listed","notnull":1,"pk":0,"type":"INTEGER"},{"name":"alternative_requests_enabled","notnull":1,"pk":0,"type":"INTEGER"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"minimum_notice_minutes","notnull":1,"pk":0,"type":"INTEGER"},{"name":"booking_horizon_days","notnull":1,"pk":0,"type":"INTEGER"},{"name":"before_buffer_minutes","notnull":1,"pk":0,"type":"INTEGER"},{"name":"after_buffer_minutes","notnull":1,"pk":0,"type":"INTEGER"},{"name":"host_day_booking_limit","notnull":0,"pk":0,"type":"INTEGER"},{"name":"location_value","notnull":1,"pk":0,"type":"TEXT"},{"name":"request_only","notnull":1,"pk":0,"type":"INTEGER"},{"name":"slot_increment_minutes","notnull":1,"pk":0,"type":"INTEGER"},{"name":"booking_horizon_mode","notnull":1,"pk":0,"type":"TEXT"},{"name":"booking_start_date","notnull":0,"pk":0,"type":"TEXT"},{"name":"booking_end_date","notnull":0,"pk":0,"type":"TEXT"},{"name":"duration_options_json","notnull":1,"pk":0,"type":"TEXT"},{"name":"post_booking_redirect_json","notnull":0,"pk":0,"type":"TEXT"},{"name":"locations_json","notnull":0,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"event_types","rowidAlias":null,"sql":"CREATE TABLE event_types (\n  id TEXT PRIMARY KEY NOT NULL,\n  status TEXT NOT NULL CHECK (status IN ('draft', 'published', 'disabled')),\n  slug TEXT NOT NULL UNIQUE,\n  title TEXT NOT NULL,\n  description TEXT NOT NULL,\n  duration_minutes INTEGER NOT NULL,\n  color TEXT NOT NULL,\n  location_type TEXT NOT NULL,\n  location_label TEXT NOT NULL,\n  listed INTEGER NOT NULL DEFAULT 1 CHECK (listed IN (0, 1)),\n  alternative_requests_enabled INTEGER NOT NULL DEFAULT 1 CHECK (alternative_requests_enabled IN (0, 1)),\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n, minimum_notice_minutes INTEGER NOT NULL DEFAULT 240\n  CHECK (minimum_notice_minutes BETWEEN 0 AND 10080), booking_horizon_days INTEGER NOT NULL DEFAULT 60\n  CHECK (booking_horizon_days BETWEEN 1 AND 365), before_buffer_minutes INTEGER NOT NULL DEFAULT 0\n  CHECK (before_buffer_minutes BETWEEN 0 AND 120), after_buffer_minutes INTEGER NOT NULL DEFAULT 0\n  CHECK (after_buffer_minutes BETWEEN 0 AND 120), host_day_booking_limit INTEGER\n  CHECK (host_day_booking_limit IS NULL OR host_day_booking_limit > 0), location_value TEXT NOT NULL DEFAULT '', request_only INTEGER NOT NULL DEFAULT 0 CHECK(request_only IN (0,1)), slot_increment_minutes INTEGER NOT NULL DEFAULT 15\n  CHECK (slot_increment_minutes IN (5, 10, 15, 30, 45, 60)), booking_horizon_mode TEXT NOT NULL DEFAULT 'calendar_days'\n  CHECK (booking_horizon_mode IN ('calendar_days', 'weekdays', 'fixed_range', 'indefinite')), booking_start_date TEXT, booking_end_date TEXT, duration_options_json TEXT NOT NULL DEFAULT '[]'\n  CHECK (json_valid(duration_options_json) AND json_type(duration_options_json) = 'array'), post_booking_redirect_json TEXT DEFAULT NULL\n  CHECK (post_booking_redirect_json IS NULL OR (json_valid(post_booking_redirect_json) AND json_type(post_booking_redirect_json) = 'object')), locations_json TEXT)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"entity","notnull":1,"pk":0,"type":"TEXT"},{"name":"label","notnull":1,"pk":0,"type":"TEXT"},{"name":"kind","notnull":1,"pk":0,"type":"TEXT"},{"name":"options_json","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"ext_custom_field_definitions","rowidAlias":null,"sql":"CREATE TABLE ext_custom_field_definitions (\n id TEXT PRIMARY KEY NOT NULL, entity TEXT NOT NULL CHECK(entity IN ('eventType','booking','availabilityRequest')),\n label TEXT NOT NULL CHECK(length(trim(label)) BETWEEN 1 AND 120),\n kind TEXT NOT NULL CHECK(kind IN ('text','long_text','single_choice','checkbox')),\n options_json TEXT NOT NULL CHECK(json_valid(options_json) AND json_type(options_json)='array'),\n created_at TEXT NOT NULL, updated_at TEXT NOT NULL,\n UNIQUE(id,entity,kind),\n CHECK((kind='single_choice' AND json_array_length(options_json) BETWEEN 1 AND 50) OR (kind<>'single_choice' AND json_array_length(options_json)=0))\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"definition_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"entity","notnull":1,"pk":0,"type":"TEXT"},{"name":"kind","notnull":1,"pk":0,"type":"TEXT"},{"name":"event_type_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"booking_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"request_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"value_json","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["availability_requests","bookings","event_types","ext_custom_field_definitions"],"name":"ext_custom_field_values","rowidAlias":null,"sql":"CREATE TABLE ext_custom_field_values (\n id TEXT PRIMARY KEY NOT NULL, definition_id TEXT NOT NULL, entity TEXT NOT NULL, kind TEXT NOT NULL,\n event_type_id TEXT REFERENCES event_types(id) ON DELETE CASCADE,\n booking_id TEXT REFERENCES bookings(id) ON DELETE CASCADE,\n request_id TEXT REFERENCES availability_requests(id) ON DELETE CASCADE,\n value_json TEXT NOT NULL CHECK(json_valid(value_json)), created_at TEXT NOT NULL, updated_at TEXT NOT NULL,\n FOREIGN KEY(definition_id,entity,kind) REFERENCES ext_custom_field_definitions(id,entity,kind) ON DELETE CASCADE,\n UNIQUE(definition_id,event_type_id), UNIQUE(definition_id,booking_id), UNIQUE(definition_id,request_id),\n CHECK((entity='eventType' AND event_type_id IS NOT NULL AND booking_id IS NULL AND request_id IS NULL) OR\n (entity='booking' AND event_type_id IS NULL AND booking_id IS NOT NULL AND request_id IS NULL) OR\n (entity='availabilityRequest' AND event_type_id IS NULL AND booking_id IS NULL AND request_id IS NOT NULL)),\n CHECK((kind='checkbox' AND json_type(value_json) IN ('true','false')) OR\n (kind IN ('text','long_text','single_choice') AND json_type(value_json)='text' AND length(json_extract(value_json,'$')) <= CASE WHEN kind='long_text' THEN 5000 WHEN kind='text' THEN 500 ELSE 120 END))\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"event_type_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"canonical_url","notnull":1,"pk":0,"type":"TEXT"},{"name":"accepted_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["event_types"],"name":"host_link_copy_reports","rowidAlias":null,"sql":"CREATE TABLE host_link_copy_reports (\n  id TEXT PRIMARY KEY NOT NULL,\n  event_type_id TEXT NOT NULL UNIQUE REFERENCES event_types(id) ON DELETE CASCADE,\n  canonical_url TEXT NOT NULL,\n  accepted_at TEXT NOT NULL,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"singleton_key","notnull":1,"pk":0,"type":"TEXT"},{"name":"handle","notnull":1,"pk":0,"type":"TEXT"},{"name":"name","notnull":1,"pk":0,"type":"TEXT"},{"name":"title","notnull":1,"pk":0,"type":"TEXT"},{"name":"biography","notnull":1,"pk":0,"type":"TEXT"},{"name":"timezone","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"avatar_key","notnull":0,"pk":0,"type":"TEXT"},{"name":"avatar_content_type","notnull":0,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"host_profiles","rowidAlias":null,"sql":"CREATE TABLE host_profiles (\n  id TEXT PRIMARY KEY NOT NULL,\n  singleton_key TEXT NOT NULL UNIQUE CHECK (singleton_key = 'default'),\n  handle TEXT NOT NULL UNIQUE,\n  name TEXT NOT NULL,\n  title TEXT NOT NULL,\n  biography TEXT NOT NULL,\n  timezone TEXT NOT NULL,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n, avatar_key TEXT, avatar_content_type TEXT)"},{"columns":[{"name":"destination","notnull":1,"pk":1,"type":"TEXT"},{"name":"identity","notnull":1,"pk":2,"type":"TEXT"}],"count":1,"dependencies":[],"name":"ik_d1_erased_sources","rowidAlias":null,"sql":"CREATE TABLE ik_d1_erased_sources (destination TEXT NOT NULL, identity TEXT NOT NULL, PRIMARY KEY(destination,identity))"},{"columns":[{"name":"destination","notnull":1,"pk":1,"type":"TEXT"},{"name":"identity","notnull":1,"pk":2,"type":"TEXT"}],"count":1,"dependencies":[],"name":"ik_d1_erased_targets","rowidAlias":null,"sql":"CREATE TABLE ik_d1_erased_targets (destination TEXT NOT NULL, identity TEXT NOT NULL, PRIMARY KEY(destination,identity))"},{"columns":[{"name":"id","notnull":0,"pk":1,"type":"TEXT"},{"name":"destination","notnull":1,"pk":0,"type":"TEXT"},{"name":"recorded_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"records_erased","notnull":1,"pk":0,"type":"INTEGER"},{"name":"jobs_retired","notnull":1,"pk":0,"type":"INTEGER"},{"name":"streams_retired","notnull":1,"pk":0,"type":"INTEGER"},{"name":"stores_json","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"ik_d1_erasure_journal","rowidAlias":null,"sql":"CREATE TABLE ik_d1_erasure_journal (id TEXT PRIMARY KEY, destination TEXT NOT NULL, recorded_at TEXT NOT NULL, records_erased INTEGER NOT NULL CHECK(records_erased>=0), jobs_retired INTEGER NOT NULL CHECK(jobs_retired>=0), streams_retired INTEGER NOT NULL CHECK(streams_retired>=0), stores_json TEXT NOT NULL CHECK(json_valid(stores_json)))"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"kind","notnull":1,"pk":2,"type":"TEXT"},{"name":"destination","notnull":1,"pk":0,"type":"TEXT"},{"name":"receipt_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"retired_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"ik_d1_retirements","rowidAlias":null,"sql":"CREATE TABLE ik_d1_retirements (id TEXT NOT NULL, kind TEXT NOT NULL CHECK(kind IN ('job','stream')), destination TEXT NOT NULL, receipt_id TEXT NOT NULL, retired_at TEXT NOT NULL, PRIMARY KEY(id, kind))"},{"columns":[{"name":"job_id","notnull":0,"pk":1,"type":"TEXT"},{"name":"mode","notnull":1,"pk":0,"type":"TEXT"},{"name":"source_handle","notnull":1,"pk":0,"type":"TEXT"},{"name":"captured_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"as_of","notnull":1,"pk":0,"type":"TEXT"},{"name":"recorded_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":[],"name":"move_in_captures","rowidAlias":null,"sql":"CREATE TABLE move_in_captures (\n  job_id TEXT PRIMARY KEY,\n  mode TEXT NOT NULL CHECK (mode IN ('first', 'catch_up')),\n  source_handle TEXT NOT NU