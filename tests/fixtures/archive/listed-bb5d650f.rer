 END","table":"ik_d1_custody_states","type":"trigger"},{"name":"ik_d1_custody_state_stream_delete","sql":"CREATE TRIGGER ik_d1_custody_state_stream_delete BEFORE DELETE ON ik_d1_streams BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT job_id FROM ik_d1_stream_pages WHERE stream_id=OLD.id); END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_custody_state_stream_update","sql":"CREATE TRIGGER ik_d1_custody_state_stream_update BEFORE UPDATE ON ik_d1_streams BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT job_id FROM ik_d1_stream_pages WHERE stream_id=OLD.id); END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_erasure_journal_delete","sql":"CREATE TRIGGER ik_d1_erasure_journal_delete BEFORE DELETE ON ik_d1_erasure_journal BEGIN SELECT RAISE(ABORT,'IMPORT_ERASURE_JOURNAL_APPEND_ONLY'); END","table":"ik_d1_erasure_journal","type":"trigger"},{"name":"ik_d1_erasure_journal_insert","sql":"CREATE TRIGGER ik_d1_erasure_journal_insert BEFORE INSERT ON ik_d1_erasure_journal WHEN EXISTS(SELECT 1 FROM ik_d1_erasure_journal WHERE id=NEW.id) BEGIN SELECT RAISE(ABORT,'IMPORT_ERASURE_JOURNAL_APPEND_ONLY'); END","table":"ik_d1_erasure_journal","type":"trigger"},{"name":"ik_d1_erasure_journal_time","sql":"CREATE INDEX ik_d1_erasure_journal_time ON ik_d1_erasure_journal(destination, recorded_at)","table":"ik_d1_erasure_journal","type":"index"},{"name":"ik_d1_erasure_journal_update","sql":"CREATE TRIGGER ik_d1_erasure_journal_update BEFORE UPDATE ON ik_d1_erasure_journal BEGIN SELECT RAISE(ABORT,'IMPORT_ERASURE_JOURNAL_APPEND_ONLY'); END","table":"ik_d1_erasure_journal","type":"trigger"},{"name":"ik_d1_history_job","sql":"CREATE INDEX ik_d1_history_job ON ik_d1_history(job_id)","table":"ik_d1_history","type":"index"},{"name":"ik_d1_history_source","sql":"CREATE INDEX ik_d1_history_source ON ik_d1_history(source_identity)","table":"ik_d1_history","type":"index"},{"name":"ik_d1_native_staging_binding","sql":"CREATE TRIGGER ik_d1_native_staging_binding BEFORE UPDATE OF id,generation,destination,namespace,mapping_version,principal_id,job_id,fingerprint,job_fence,action,values_count,chunks_count,identities ON ik_d1_native_staging BEGIN SELECT RAISE(ABORT,'IMPORT_NATIVE_STAGE_BINDING_CHANGED'); END","table":"ik_d1_native_staging","type":"trigger"},{"name":"ik_d1_native_staging_index_custody_delete","sql":"CREATE TRIGGER ik_d1_native_staging_index_custody_delete AFTER DELETE ON ik_d1_native_staging_index BEGIN DELETE FROM ik_d1_native_staging_values WHERE stage_id=OLD.stage_id; END","table":"ik_d1_native_staging_index","type":"trigger"},{"name":"ik_d1_native_staging_index_custody_insert","sql":"CREATE TRIGGER ik_d1_native_staging_index_custody_insert AFTER INSERT ON ik_d1_native_staging_index BEGIN DELETE FROM ik_d1_native_staging_values WHERE stage_id=NEW.stage_id; END","table":"ik_d1_native_staging_index","type":"trigger"},{"name":"ik_d1_native_staging_index_custody_update","sql":"CREATE TRIGGER ik_d1_native_staging_index_custody_update AFTER UPDATE ON ik_d1_native_staging_index BEGIN DELETE FROM ik_d1_native_staging_values WHERE stage_id=OLD.stage_id OR stage_id=NEW.stage_id; END","table":"ik_d1_native_staging_index","type":"trigger"},{"name":"ik_d1_native_staging_index_delete","sql":"CREATE TRIGGER ik_d1_native_staging_index_delete AFTER DELETE ON ik_d1_native_staging_index BEGIN UPDATE ik_d1_native_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=OLD.stage_id; END","table":"ik_d1_native_staging_index","type":"trigger"},{"name":"ik_d1_native_staging_index_insert","sql":"CREATE TRIGGER ik_d1_native_staging_index_insert AFTER INSERT ON ik_d1_native_staging_index BEGIN UPDATE ik_d1_native_staging SET revision=revision+1,sealed_revision=NULL,registered_revision=NULL WHERE id=NEW.stage_id; END","table":"ik_d1_native_staging_index","type":"trigger"},{"name":"ik_d1_native_staging_index_update","sql":"CREATE TRIGGER ik_d1_native_staging