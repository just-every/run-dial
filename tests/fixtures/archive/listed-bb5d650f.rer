me":"ik_d1_custody_state_ik_original_sets_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_original_sets_insert AFTER INSERT ON ik_original_sets BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_original_sets","type":"trigger"},{"name":"ik_d1_custody_state_ik_original_sets_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_original_sets_update AFTER UPDATE ON ik_original_sets BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_original_sets","type":"trigger"},{"name":"ik_d1_custody_state_ik_originals_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_originals_delete AFTER DELETE ON ik_originals BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_originals","type":"trigger"},{"name":"ik_d1_custody_state_ik_originals_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_originals_insert AFTER INSERT ON ik_originals BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_originals","type":"trigger"},{"name":"ik_d1_custody_state_ik_originals_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_originals_update AFTER UPDATE ON ik_originals BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_originals","type":"trigger"},{"name":"ik_d1_custody_state_ik_provenance_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_provenance_delete AFTER DELETE ON ik_provenance BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_provenance","type":"trigger"},{"name":"ik_d1_custody_state_ik_provenance_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_provenance_insert AFTER INSERT ON ik_provenance BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_provenance","type":"trigger"},{"name":"ik_d1_custody_state_ik_