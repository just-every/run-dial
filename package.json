{
  "name": "dial",
  "version": "0.1.0",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/just-every/run-dial.git" },
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "runtime:config": "node scripts/render-wrangler.mjs",
    "dev": "node scripts/rer.mjs dev",
    "setup": "node scripts/rer.mjs setup",
    "deploy": "node scripts/rer.mjs deploy",
    "health": "node scripts/deploy.mjs health",
    "teardown:plan": "node scripts/teardown.mjs plan",
    "teardown": "node scripts/teardown.mjs delete",
    "operations:describe": "node scripts/operations.mjs describe",
    "operations:check": "node scripts/operations.mjs check",
    "build": "node scripts/rer.mjs build",
    "preview": "node scripts/rer.mjs preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "lint": "eslint src tests scripts vite.config.ts --max-warnings=0",
    "boundaries": "node scripts/check-boundaries.mjs",
    "validate": "node scripts/validate-manifest-contract.mjs",
    "migration:check": "node scripts/check-migrations.mjs",
    "verify": "node scripts/rer.mjs verify",
    "review": "node scripts/review.mjs",
    "export": "node scripts/rer.mjs export",
    "import": "node scripts/rer.mjs import",
    "reset": "node scripts/rer.mjs reset",
    "release": "node scripts/rer.mjs release",
    "outbox": "node scripts/rer.mjs outbox",
    "doctor": "node scripts/rer.mjs doctor",
    "describe": "node scripts/rer.mjs describe",
    "check": "node scripts/rer.mjs check",
    "deps": "node scripts/rer.mjs install",
    "rer": "node scripts/rer.mjs",
    "build:app": "node scripts/render-wrangler.mjs && vite build && node scripts/assert-build-output.mjs",
    "verify:app": "node scripts/verify.mjs",
    "verify:copies": "node scripts/verify-base-copies.mjs && node scripts/edition-authoring/cli.mjs verify-base --offline",
    "verify:delivery": "node scripts/verify-delivery-artifact.mjs",
    "verify:managed-editor": "node scripts/verify-managed-editor.mjs",
    "delivery:artifact": "node scripts/build-delivery-artifact.mjs",
    "integrations:check": "node scripts/projects/integrations.mjs check",
    "move-in:download-calendly": "node --experimental-strip-types scripts/move-in/download-calendly.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cloudflare/vite-plugin": "^1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.17",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.0.0",
    "highlight.js": "10.7.3",
    "react-markdown": "6.0.3",
    "remark-gfm": "1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.2.2",
    "wrangler": "^4.129.1"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-start": "1.168.50",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ulid": "^3.0.2",
    "zod": "^4.1.5"
  },
  "engines": {
    "node": "22.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
