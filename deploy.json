{
  "version": 1,
  "project": "just-every/dial",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "APP_URL",
  "platforms": [
    "workers",
    "container"
  ],
  "container": {
    "engine": "workerd"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "MAIL_PROVIDER": "sendgrid"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "SENDGRID_API_KEY"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM",
      "verifyStandIn": "noreply@dial.test"
    },
    {
      "binding": "QBO_CLIENT_ID",
      "environment": "QBO_CLIENT_ID",
      "optional": true
    },
    {
      "binding": "QBO_CLIENT_SECRET",
      "environment": "QBO_CLIENT_SECRET",
      "optional": true
    },
    {
      "binding": "QBO_ENVIRONMENT",
      "environment": "QBO_ENVIRONMENT",
      "optional": true,
      "verifyStandIn": "production"
    },
    {
      "binding": "SLACK_CLIENT_ID",
      "environment": "SLACK_CLIENT_ID",
      "optional": true
    },
    {
      "binding": "SLACK_CLIENT_SECRET",
      "environment": "SLACK_CLIENT_SECRET",
      "optional": true
    }
  ],
  "queues": [
    {
      "binding": "JOBS",
      "consumer": {
        "batch_size": 10,
        "max_retries": 3
      },
      "deadLetterQueue": "JOBS_DEAD"
    },
    {
      "binding": "JOBS_DEAD"
    }
  ],
  "crons": [
    "* * * * *"
  ],
  "r2": [
    {
      "binding": "FILES"
    }
  ],
  "durableObjects": [
    {
      "binding": "BOOKING_COORDINATOR",
      "className": "BookingCoordinator",
      "storage": "sqlite"
    }
  ]
}
