{
  "schema": 1,
  "title": "Dial",
  "groups": [
    {
      "id": "owner",
      "label": "First owner"
    },
    {
      "id": "mail",
      "label": "Sign-in email",
      "help": "Managed hosting supplies mail automatically. Other hosted installs need a verified sender and provider credentials."
    },
    {
      "id": "payments",
      "label": "Stripe payments (optional)",
      "help": "Only for paid event types (PAY-001). Use your own Stripe platform account; leave these blank to keep every event type free."
    }
  ],
  "fields": [
    {
      "name": "OWNER_EMAIL",
      "label": "Owner email",
      "help": "This address will own Dial and receive sign-in links.",
      "kind": "email",
      "required": true,
      "prefill": "account-email",
      "group": "owner"
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Email provider",
      "kind": "select",
      "required": true,
      "default": "sendgrid",
      "options": [
        {
          "value": "development",
          "label": "Local development outbox"
        },
        {
          "value": "rer",
          "label": "RER Managed mail"
        },
        {
          "value": "sendgrid",
          "label": "SendGrid"
        },
        {
          "value": "resend",
          "label": "Resend"
        }
      ],
      "group": "mail"
    },
    {
      "name": "MAIL_FROM",
      "label": "Sender email",
      "help": "Use an address verified with your email provider.",
      "kind": "email",
      "required": true,
      "group": "mail"
    },
    {
      "name": "MAIL_RELAY_URL",
      "label": "Managed mail relay URL",
      "kind": "url",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "group": "mail",
      "help": "Supplied automatically by RER Managed hosting."
    },
    {
      "name": "MAIL_API_KEY",
      "label": "Mail API key",
      "kind": "secret",
      "input": "entered",
      "required": false,
      "ownerVisible": true,
      "group": "mail",
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "label": "RER mail credential",
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "label": "SendGrid API key",
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "label": "Resend API key",
          "required": true
        }
      ]
    },
    {
      "name": "STRIPE_SECRET_KEY",
      "label": "Stripe secret key",
      "help": "Your Stripe platform secret key (sk_…). Dial uses it for Connect, Checkout and webhook-confirmed bookings.",
      "kind": "secret",
      "input": "entered",
      "required": false,
      "ownerVisible": true,
      "group": "payments"
    },
    {
      "name": "STRIPE_CONNECT_CLIENT_ID",
      "label": "Stripe Connect client ID",
      "help": "From Stripe Dashboard → Connect → Settings (ca_…). Register the redirect URI shown in Dial Settings.",
      "kind": "secret",
      "input": "entered",
      "required": false,
      "ownerVisible": true,
      "group": "payments"
    },
    {
      "name": "STRIPE_WEBHOOK_SECRET",
      "label": "Stripe webhook signing secret",
      "help": "The signing secret (whsec_…) of a Connect webhook endpoint for your Dial address followed by /api/webhooks/stripe.",
      "kind": "secret",
      "input": "entered",
      "required": false,
      "ownerVisible": true,
      "group": "payments"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "IDENTITY_PROVIDER",
      "label": "Identity provider",
      "kind": "url",
      "required": false,
      "default": "",
      "help": "Optional Auth install. Leave empty to use email links."
    }
  ],
  "steps": [
    {
      "type": "owner-claim",
      "mode": "signed",
      "emailField": "OWNER_EMAIL",
      "tokenField": "SETUP_TOKEN",
      "path": "/auth/owner-claim"
    }
  ],
  "dependencies": [
    {
      "interface": "oidc-provider@1",
      "optional": true,
      "cardinality": 1,
      "address": "IDENTITY_PROVIDER",
      "paths": [
        "/auth/oidc/auth/callback",
        "/auth/oidc/auth/logout"
      ]
    }
  ]
}
